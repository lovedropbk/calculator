<UserControl
    x:Class="FinancialCalculator.WinUI3.Controls.CampaignDesignerHeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Expect DataContext = MainViewModel -->
    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource DesignerTileGap}"
                    Margin="{StaticResource DesignerHeaderMargin}"
                    VerticalAlignment="Center">
            <TextBlock x:Uid="CampaignDesigner_Header_Title"
                       Style="{StaticResource DesignerSectionHeaderTextStyle}"
                       VerticalAlignment="Center"/>

            <Button x:Uid="CampaignDesigner_Header_ClearAll_Button"
                    Command="{Binding Comparison.ClearComparisonCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    AccessKey="C"
                    AutomationProperties.AcceleratorKey="Alt+C"
                    AutomationProperties.Name="Clear all campaign tiles">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                    <TextBlock x:Uid="CampaignDesigner_Header_ClearAll_Text"/>
                </StackPanel>
            </Button>

            <ToggleSwitch x:Name="DesignerDetailsToggle"
                          x:Uid="CampaignDesigner_Header_DetailsToggle"
                          Style="{StaticResource DenseToggleSwitchStyle}"
                          IsOn="{Binding Comparison.IsDesignerDetailed, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          AccessKey="D"
                          AutomationProperties.AcceleratorKey="Alt+D"
                          AutomationProperties.Name="Toggle designer tile details (compact/detailed)"/>
        </StackPanel>
    </Grid>
</UserControl>