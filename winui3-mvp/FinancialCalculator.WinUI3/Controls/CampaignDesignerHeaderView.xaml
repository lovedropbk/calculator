<UserControl
    x:Class="FinancialCalculator.WinUI3.Controls.CampaignDesignerHeaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Expect DataContext = MainViewModel -->
    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource DesignerTileGap}"
                    Margin="{StaticResource DesignerHeaderMargin}"
                    VerticalAlignment="Center">
            <TextBlock Text="Campaign Designer"
                       Style="{StaticResource CardHeaderTextStyle}"
                       FontSize="{StaticResource FontSizeDisplay}"
                       VerticalAlignment="Center"/>

            <Button Command="{Binding Comparison.ClearComparisonCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Clear all campaign tiles">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                    <TextBlock Text="Clear All"/>
                </StackPanel>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Clear all designer tiles"/>
                </ToolTipService.ToolTip>
            </Button>

            <ToggleSwitch x:Name="DesignerDetailsToggle"
                          Style="{StaticResource DenseToggleSwitchStyle}"
                          OnContent="Detailed"
                          OffContent="Compact"
                          IsOn="{Binding Comparison.IsDesignerDetailed, Mode=TwoWay}"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="Toggle designer tile details (compact/detailed)"/>
        </StackPanel>
    </Grid>
</UserControl>