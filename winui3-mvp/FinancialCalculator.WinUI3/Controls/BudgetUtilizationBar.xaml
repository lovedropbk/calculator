<UserControl
    x:Class="FinancialCalculator.WinUI3.Controls.BudgetUtilizationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel>
        <Grid Height="24" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Details.BudgetUtilization.CashDiscountPct}"/>
                <ColumnDefinition Width="{Binding Details.BudgetUtilization.SubDownPct}"/>
                <ColumnDefinition Width="{Binding Details.BudgetUtilization.RateSubsidyPct}"/>
                <ColumnDefinition Width="{Binding Details.BudgetUtilization.IdcPct}"/>
                <ColumnDefinition Width="{Binding Details.BudgetUtilization.UnallocatedPct}"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="{ThemeResource BudgetCashBrush}"/>
            <Rectangle Grid.Column="1" Fill="{ThemeResource BudgetSubDownBrush}"/>
            <Rectangle Grid.Column="2" Fill="{ThemeResource BudgetRateSubsidyBrush}"/>
            <Rectangle Grid.Column="3" Fill="{ThemeResource BudgetIdcBrush}"/>
            <Rectangle Grid.Column="4" Fill="{ThemeResource BudgetUnallocatedBrush}"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceM}" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}"><Rectangle Width="12" Height="12" Fill="{ThemeResource BudgetCashBrush}"/><TextBlock x:Uid="BudgetUtilization_Legend_CashDisc" Text="Cash Disc." FontSize="11"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}"><Rectangle Width="12" Height="12" Fill="{ThemeResource BudgetSubDownBrush}"/><TextBlock x:Uid="BudgetUtilization_Legend_SubDown" Text="SubDown" FontSize="11"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}"><Rectangle Width="12" Height="12" Fill="{ThemeResource BudgetRateSubsidyBrush}"/><TextBlock x:Uid="BudgetUtilization_Legend_RateSub" Text="Rate Sub." FontSize="11"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}"><Rectangle Width="12" Height="12" Fill="{ThemeResource BudgetIdcBrush}"/><TextBlock x:Uid="BudgetUtilization_Legend_IDCs" Text="IDCs" FontSize="11"/></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXS}"><Rectangle Width="12" Height="12" Fill="{ThemeResource BudgetUnallocatedBrush}"/><TextBlock x:Uid="BudgetUtilization_Legend_Unallocated" Text="Unallocated" FontSize="11"/></StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>