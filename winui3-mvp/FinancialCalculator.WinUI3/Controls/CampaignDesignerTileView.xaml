<UserControl
    x:Class="FinancialCalculator.WinUI3.Controls.CampaignDesignerTileView"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Expect DataContext = CampaignTileViewModel -->
    <Border Style="{StaticResource DesignerTileContainerStyle}">
        <StackPanel Spacing="{StaticResource SpaceS}">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding Title, Mode=TwoWay}"
                         Style="{StaticResource DesignerTileTitleTextStyle}"
                         VerticalAlignment="Center"/>

                <ToggleSwitch Grid.Column="1"
                              Style="{StaticResource DenseToggleSwitchStyle}"
                              IsOn="{Binding ElementName=Self, Path=IsDetailed, Mode=TwoWay}"
                              OnContent="Details"
                              OffContent="Compact"
                              Margin="8,0,8,0"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Title, Converter={StaticResource TextFormatConverter}, ConverterParameter='Show breakdown for {0}'}"/>
                <!-- Remove (X) button: parent will usually supply RemoveCommand via DP -->
                <Button Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{Binding ElementName=Self, Path=RemoveCommand}"
                        CommandParameter="{Binding}"
                        ToolTipService.ToolTip="Remove campaign"
                        AutomationProperties.Name="{Binding Title, Converter={StaticResource TextFormatConverter}, ConverterParameter='Remove campaign {0}'}">
                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                </Button>
            </Grid>

            <!-- Basic info -->
            <StackPanel Spacing="{StaticResource SpaceXS}">
                <TextBlock FontWeight="SemiBold">
                    <Run Text="Model: "/>
                    <Run Text="{Binding ModelName}"/>
                </TextBlock>
                <TextBlock FontWeight="SemiBold">
                    <Run Text="Campaign: "/>
                    <Run Text="{Binding Title}"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceL}" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Product" Style="{StaticResource TokenCaptionTextStyle}"/>
                        <TextBlock Text="{Binding Product}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Avg RoRAC" Style="{StaticResource TokenCaptionTextStyle}"/>
                        <TextBlock Text="{Binding AvgRoRAC}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Per-term breakdown -->
            <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Visibility="{Binding ElementName=Self, Path=IsDetailed, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Term Breakdown"
                               FontWeight="SemiBold"
                               Style="{StaticResource TokenCaptionTextStyle}"
                               Margin="0,0,0,8" />

                    <!-- Column headers -->
                    <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Term" Style="{StaticResource TokenCaptionTextStyle}"/>
                        <TextBlock Grid.Column="1" Text="Rate (% p.a.)" Style="{StaticResource TokenCaptionTextStyle}"/>
                        <TextBlock Grid.Column="2" Text="Volume Share (%)" Style="{StaticResource TokenCaptionTextStyle}"/>
                        <TextBlock Grid.Column="3" Text="RoRAC" Style="{StaticResource TokenCaptionTextStyle}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Rows -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding TermBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding TermLabel}" VerticalAlignment="Center"/>

                                    <!-- Customer rate editable -->
                                    <muxc:NumberBox Grid.Column="1"
                                                    Style="{StaticResource DenseNumberBoxStyle}"
                                                    Value="{Binding CustomerRatePct, Mode=TwoWay}"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                    HorizontalAlignment="Stretch" />

                                    <!-- Distribution % editable -->
                                    <muxc:NumberBox Grid.Column="2"
                                                    Style="{StaticResource DenseNumberBoxStyle}"
                                                    Value="{Binding DistributionPct, Mode=TwoWay}"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                    HorizontalAlignment="Stretch" />

                                    <!-- Per-term RoRAC -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding RoRAC}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- Campaign volume and controls -->
            <Grid Margin="0,8,0,0"
                  Visibility="{Binding ElementName=Self, Path=IsDetailed, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Acquisition Units" Style="{StaticResource TokenCaptionTextStyle}"/>
                    <muxc:NumberBox Value="{Binding CampaignUnits, Mode=TwoWay}"
                                    Minimum="0"
                                    NumberFormatter="{StaticResource GroupedZeroFormatter}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <StackPanel>
                        <TextBlock Text="Volume Share (%)" Style="{StaticResource TokenCaptionTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock HorizontalAlignment="Right" Text="{Binding CampaignVolumePctText}"/>
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="Average RoRAC" Style="{StaticResource TokenCaptionTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding AvgRoRAC}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>