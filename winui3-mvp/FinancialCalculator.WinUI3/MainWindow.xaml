<Window
    x:Class="FinancialCalculator.WinUI3.MainWindow"
    x:Name="Root"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localCtrls="using:FinancialCalculator.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:FinancialCalculator.WinUI3.ViewModels"
    mc:Ignorable="d"
    Title="Financial Calculator Pro">

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Modifiers="None" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>
        
        <!-- Bottom-right toast for notifications (non-blocking, dismissible) -->
        <Grid x:Name="NotificationToastHost"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              Margin="12"
              Canvas.ZIndex="9999"
              IsHitTestVisible="False">
            <muxc:InfoBar x:Name="NotificationBar"
                          MaxWidth="380"
                          IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
                          IsClosable="True"
                          Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
                          Title="Notification"
                          Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                          Style="{StaticResource NotificationInfoBarStyle}"
                          IsHitTestVisible="True"/>
        </Grid>

        <!-- MARK: Root TabView with Icons -->
        <TabView x:Name="MainTabView"
                 TabWidthMode="Equal"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 Margin="0,0,0,0">
            
            <!-- MARK: Main Tab with Icon -->
            <TabView.TabItems>
                <TabViewItem IsClosable="False" Style="{StaticResource IconTabViewItemStyle}">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE80F;" FontSize="16"/>
                            <TextBlock Text="Main Calculator" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabViewItem.Header>
                <Grid x:Name="LayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" MaxHeight="50"/><!-- Footer -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Deal Input Mask (collapsible) -->
                        <ColumnDefinition x:Name="LeftColumn"
                                          Width="{Binding ViewModel.DealInput.IsDealInputsCollapsed, ElementName=Root, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter='36|2*'}"
                                          MinWidth="{Binding ViewModel.DealInput.IsDealInputsCollapsed, ElementName=Root, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='36|360'}"/>
                        <!-- Center: Main content -->
                        <ColumnDefinition Width="3*" MinWidth="480"/>
                        <!-- Grid Splitter -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Right: Campaign Details (collapsible) -->
                        <ColumnDefinition x:Name="RightColumn"
                                          Width="{Binding ViewModel.IsCampaignDetailsCollapsed, ElementName=Root, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter='36|2*'}"
                                          MinWidth="{Binding ViewModel.IsCampaignDetailsCollapsed, ElementName=Root, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='36|360'}"/>
                    </Grid.ColumnDefinitions>

        <!-- MARK: LEFT - Deal Input Mask with Collapse Toggle -->
        <Grid Grid.Row="0" Grid.Column="0">
            <!-- Deal Input Content Area -->
            <Border x:Name="DealInputsCard"
                    Margin="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter='12,12,8,12|0,12,0,12'}"
                    Padding="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter='16,16,16,16|4,4,4,4'}"
                    Style="{StaticResource CardContainerStyle}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              Style="{StaticResource ResponsiveScrollViewer}">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Style>
                        </Grid.Style>
                        <StackPanel Spacing="8">
                
                            <!-- Deal Inputs -->
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource DetailsLabelColumnWidth}"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
        
                                <!-- Header -->
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Deal Inputs" Style="{StaticResource CardHeaderTextStyle}"/>
        
                                <!-- Vehicle Selection -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vehicle" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DealInput.AllVehicles}"
                                              SelectedItem="{Binding DealInput.SelectedVehicle, Mode=TwoWay}"
                                              DisplayMemberPath="ModelName"
                                              Style="{StaticResource CompactComboBox}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Select Class or Model"/>
                                </Grid>

                                <!-- Product (display HP, mySTAR, FL, OL; map to engine tags) -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Product" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DealInput.Product, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource CompactComboBox}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="HP" Tag="HP"/>
                                        <ComboBoxItem Content="mySTAR" Tag="mySTAR"/>
                                        <ComboBoxItem Content="FL" Tag="F-Lease"/>
                                        <ComboBoxItem Content="OL" Tag="Op-Lease"/>
                                    </ComboBox>
                                </Grid>
        
                                <!-- Term with Tooltip -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Term (months)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Loan term duration in months" Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DealInput.TermMonths, Mode=TwoWay}" Style="{StaticResource CompactComboBox}" HorizontalAlignment="Stretch">
                                        <x:Int32>12</x:Int32>
                                        <x:Int32>24</x:Int32>
                                        <x:Int32>36</x:Int32>
                                        <x:Int32>48</x:Int32>
                                        <x:Int32>60</x:Int32>
                                        <x:Int32>72</x:Int32>
                                        <x:Int32>84</x:Int32>
                                    </ComboBox>
                                </Grid>
        
                                <!-- Payment Mode (Timing binding) -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment Mode" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DealInput.Timing, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource CompactComboBox}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="arrears" Tag="arrears"/>
                                        <ComboBoxItem Content="in advance" Tag="advance"/>
                                    </ComboBox>
                                </Grid>
        
                                <!-- MSRP with Tooltip -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="MSRP" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Enter the MSRP excluding tax" Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <muxc:NumberBox Grid.Column="1" Style="{StaticResource CompactNumberBox}"
                                                    Value="{Binding DealInput.PriceExTax, Mode=TwoWay}"
                                                    PlaceholderText="{Binding DealInput.PricePlaceholder}"
                                                    NumberFormatter="{StaticResource GroupedZeroFormatter}"/>
                                </Grid>

                                <!-- MBTh Discount -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="MBTh Discount" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <muxc:NumberBox Grid.Column="1" Style="{StaticResource CompactNumberBox}"
                                                    Value="{Binding DealInput.MbthDiscount, Mode=TwoWay}"
                                                    PlaceholderText="THB"
                                                    NumberFormatter="{StaticResource GroupedZeroFormatter}"/>
                                </Grid>

                                <!-- Transaction Price (read-only) -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Transaction Price" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <muxc:NumberBox Grid.Column="1" Style="{StaticResource CompactNumberBox}"
                                                    Value="{Binding DealInput.TransactionPrice}"
                                                    IsEnabled="False"
                                                    NumberFormatter="{StaticResource GroupedZeroFormatter}"/>
                                </Grid>

                                <!-- Additional Financed Items -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Additional Financed Items" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <muxc:NumberBox Grid.Column="1" Style="{StaticResource CompactNumberBox}"
                                                    Value="{Binding DealInput.AdditionalFinancedItems, Mode=TwoWay}"
                                                    PlaceholderText="THB"
                                                    NumberFormatter="{StaticResource GroupedZeroFormatter}"/>
                                </Grid>
         
                                <!-- Down Payment: unit first then value (inside value area) -->
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Down payment" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" SelectedItem="{Binding DealInput.DownPaymentUnit, Mode=TwoWay}" Margin="0,0,6,0" Style="{StaticResource CompactComboBox}" MinWidth="60" HorizontalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <x:String>THB</x:String>
                                        <x:String>%</x:String>
                                    </ComboBox>
                                    <muxc:NumberBox Grid.Column="1" Style="{StaticResource CompactNumberBox}" Value="{Binding DealInput.DownPaymentValueEntry, Mode=TwoWay}" PlaceholderText="{Binding DealInput.DownPaymentPlaceholder}" NumberFormatter="{StaticResource GroupedZeroFormatter}">
                                        <muxc:NumberBox.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Goal Seek: Solve for Down Payment" Command="{Binding GoalSeekSolveForDownPaymentCommand}">
                                                     <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE71A;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </muxc:NumberBox.ContextFlyout>
                                    </muxc:NumberBox>
                                </Grid>

                                <!-- Balloon: unit first then value (inside value area) -->
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Balloon" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" HorizontalAlignment="Left" Width="{StaticResource ValueAreaWidth}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" SelectedItem="{Binding DealInput.BalloonUnit, Mode=TwoWay}" IsEnabled="{Binding DealInput.IsBalloonEnabled}" Margin="0,0,6,0" Style="{StaticResource CompactComboBox}" MinWidth="60" HorizontalContentAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <x:String>THB</x:String>
                                        <x:String>%</x:String>
                                    </ComboBox>
                                    <TextBox Grid.Column="1" Text="{Binding DealInput.BalloonValueEntry, Mode=TwoWay}" PlaceholderText="{Binding DealInput.BalloonPlaceholder}" IsEnabled="{Binding DealInput.IsBalloonEnabled}" Style="{StaticResource CompactTextBox}"/>
                                </Grid>
        
                                <!-- Subsidy budget with Tooltip (label styled like others) -->
                                <TextBlock Grid.Row="11" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Text="Subsidy budget (THB)" Style="{StaticResource LabelTextStyle}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Available subsidy budget for this deal. Click to solve for target RoRAC." Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <!-- Create a proper overlay structure aligned like single-field rows -->
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                            <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                        </Grid.ColumnDefinitions>
                                        <muxc:NumberBox Grid.Column="1" Style="{StaticResource CompactNumberBox}" Value="{Binding DealInput.SubsidyBudget, Mode=TwoWay}"
                                                        PlaceholderText="THB"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        IsEnabled="{Binding DealInput.SubsidyBudgetIsEnabled}"
                                                        IsHitTestVisible="{Binding GoalSeek.IsTargetSet, Converter={StaticResource BoolNotConverter}}"
                                                        Minimum="0"
                                                        AcceptsExpression="False">
                                            <muxc:NumberBox.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Goal Seek: Solve for Subsidy (to target RoRAC)" Command="{Binding GoalSeekSolveForSubsidyAutoAsyncCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE71A;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </muxc:NumberBox.ContextFlyout>
                                        </muxc:NumberBox>
                                        <!-- Overlay button that covers the entire NumberBox -->
                                        <Button Grid.ColumnSpan="2" Command="{Binding GoalSeekSolveForSubsidyAutoAsyncCommand}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Visibility="{Binding GoalSeek.IsTargetSet, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border BorderBrush="Gold" BorderThickness="2" Background="Transparent" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="Click to solve for Subsidy Budget to achieve target RoRAC" />
                                            </ToolTipService.ToolTip>
                                        </Button>
                                    </Grid>
                                </Grid>
        
                                <!-- IDCs - Dealer Commission -->
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="IDCs – Commission" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" HorizontalAlignment="Left" Width="{StaticResource ValueAreaWidth}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Inline editor (shown on demand) -->
                                    <ComboBox Grid.Column="0"
                                              SelectedItem="{Binding DealInput.CommissionEntryUnit, Mode=TwoWay}"
                                              Margin="0,0,6,0"
                                              Style="{StaticResource CompactComboBox}"
                                              MinWidth="60"
                                              HorizontalContentAlignment="Center"
                                              Visibility="{Binding DealInput.IsCommissionEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <x:String>auto</x:String>
                                        <x:String>%</x:String>
                                        <x:String>THB</x:String>
                                    </ComboBox>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding DealInput.CommissionEntryValue, Mode=TwoWay}"
                                             IsEnabled="{Binding DealInput.IsCommissionEntryEditable}"
                                             Style="{StaticResource CompactTextBox}"
                                             Visibility="{Binding DealInput.IsCommissionEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Summary pill in same row when editor hidden (align with value column) -->
                                    <Border Grid.Column="1"
                                            Style="{StaticResource PillBorderStyle}"
                                            Visibility="{Binding DealInput.IsCommissionEditorVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock>
                                                    <Run Text="{Binding DealInput.DealerCommissionMode}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding DealInput.DealerCommissionPctText}"/>
                                                    <Run Text="% ("/>
                                                    <Run Text="{Binding DealInput.DealerCommissionResolvedAmtText}"/>
                                                    <Run Text=" THB)"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Command="{Binding DealInput.ShowCommissionEditorCommand}" />
                                        </Grid>
                                    </Border>
                                </Grid>
        
                                <!-- Optional override editors (shown only when override) -->
                                <StackPanel Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0"
                                            Visibility="{Binding DealInput.DealerCommissionMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=override}">
                                    <TextBlock Text="Pct %" Style="{StaticResource LabelTextStyle}"/>
                                    <TextBox Width="100" Text="{Binding DealInput.DealerCommissionPct, Mode=TwoWay}"/>
                                    <TextBlock Text="Amt THB" Style="{StaticResource LabelTextStyle}" Margin="8,0,0,0"/>
                                    <TextBox Width="140" Text="{Binding DealInput.DealerCommissionAmt, Mode=TwoWay}"/>
                                </StackPanel>
        
                                <!-- IDCs - Other with Tooltip -->
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="IDCs – Other (THB)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Other indirect costs" Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <muxc:NumberBox Grid.Column="1" Style="{StaticResource CompactNumberBox}"
                                                    Value="{Binding DealInput.IdcOther, Mode=TwoWay}"
                                                    PlaceholderText="THB"
                                                    NumberFormatter="{StaticResource GroupedZeroFormatter}"/>
                                </Grid>
        
                                <!-- Rate mode: RadioButtons (bind SelectedIndex) -->
                                <TextBlock Grid.Row="16" Grid.Column="0" Text="Rate mode" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButtons Grid.Column="1" SelectedIndex="{Binding DealInput.RateModeIndex, Mode=TwoWay}">
                                        <x:String>Fixed Rate</x:String>
                                        <x:String>Target Installment</x:String>
                                    </RadioButtons>
                                </Grid>
        
                                <!-- Customer rate label (styled like others) -->
                                <TextBlock Grid.Row="17" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,6,0,0"
                                           Text="Customer rate (% p.a.)"
                                           Style="{StaticResource LabelTextStyle}"
                                           Visibility="{Binding DealInput.IsFixedRateMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=True}"/>
                                <Grid Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left"
                                      Visibility="{Binding DealInput.IsFixedRateMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=True}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                    <!-- Nominal Rate Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBox Text="{Binding DealInput.CustomerNominalRate, Mode=TwoWay}" MinWidth="100" IsReadOnly="{Binding GoalSeek.IsTargetSet}" Style="{StaticResource CompactTextBox}">
                                                    <TextBox.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Goal Seek: Solve for Rate (to target RoRAC)" Command="{Binding GoalSeekSolveForRateAutoAsyncCommand}">
                                                                <MenuFlyoutItem.Icon>
                                                                    <FontIcon Glyph="&#xE71A;" />
                                                                </MenuFlyoutItem.Icon>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </TextBox.ContextFlyout>
                                                </TextBox>
                                                <Button Command="{Binding GoalSeekSolveForRateAutoAsyncCommand}"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        Visibility="{Binding GoalSeek.IsTargetSet, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border BorderBrush="Gold" BorderThickness="2" Background="Transparent" CornerRadius="4">
                                                                 <ToolTipService.ToolTip>
                                                                     <ToolTip Content="Click to solve for Customer Rate to achieve target RoRAC" />
                                                                 </ToolTipService.ToolTip>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="(nominal)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" FontSize="12"/>
                                        </Grid>
                                        <FontIcon Grid.Column="1" Glyph="&#xE7BA;" Foreground="DarkOrange"
                                                  Visibility="{Binding DealInput.IsRateDeviation, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Margin="8,0,0,0" VerticalAlignment="Center">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="Rate deviates from standard" Style="{StaticResource InformativeToolTipStyle}"/>
                                            </ToolTipService.ToolTip>
                                        </FontIcon>
                                    </Grid>
                                    <!-- Flat Rate Row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DealInput.CustomerFlatRate, Mode=TwoWay}" MinWidth="100" Style="{StaticResource CompactTextBox}"/>
                                        <TextBlock Grid.Column="1" Text="(flat)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                               </Grid>
        
                                <!-- Target installment (visible if target installment) -->
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="Target installment (THB)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Visibility="{Binding DealInput.IsTargetInstallmentMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=True}"/>
                                <Grid Grid.Row="18" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left"
                                      Visibility="{Binding DealInput.IsTargetInstallmentMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=True}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="1" Text="{Binding DealInput.TargetInstallment, Mode=TwoWay}" Style="{StaticResource CompactTextBox}" HorizontalAlignment="Stretch"/>
                                </Grid>
        
                                <!-- Loading indicator (no status text; hidden when idle) -->
                                <StackPanel Grid.Row="19" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="12" Margin="8,16,0,0"
                                            Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVisibilityConverter}}">
                                     <ProgressRing x:Name="CalculationProgress"
                                                   IsActive="{Binding IsCalculating}"
                                                   Width="20"
                                                   Height="20"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Goal Seek Expander (Moved above Risk Parameters) -->
                            <muxc:Expander Header="Goal Seek" HorizontalAlignment="Stretch" IsExpanded="{Binding GoalSeek.IsOpen, Mode=TwoWay}" Margin="0,12,0,0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Target RoRAC (%):" Style="{StaticResource LabelTextStyle}"/>
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <muxc:NumberBox Grid.Column="0"
                                                        Value="{Binding GoalSeek.TargetValue, Mode=TwoWay}"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        SmallChange="0.1"
                                                        LargeChange="1"
                                                        SpinButtonPlacementMode="Inline"
                                                        AcceptsExpression="False"
                                                        PlaceholderText="e.g. 15 (for 15%)"
                                                        Width="150"/>
                                        <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                    <TextBlock Text="Click on the highlighted 'Customer Rate' or 'Subsidy Budget' fields to auto-solve for the target RoRAC."
                                               Style="{StaticResource LabelTextStyle}" Opacity="0.7" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </muxc:Expander>

                            <!-- Cashflow adjustments moved to Cashflows tab -->

                            <!-- Risk Parameters Expander -->
                            <muxc:Expander Header="Risk Parameters" HorizontalAlignment="Stretch" IsExpanded="False" Margin="0,12,0,0">
                                <Grid RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Customer Type" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding DealInput.SelectedCustomerType, Mode=TwoWay}"
                                              ItemsSource="{Binding DealInput.CustomerTypes}"
                                              Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                              HorizontalAlignment="Left" Margin="8,0,0,0"/>

                                    <TextBlock Text="Asset State" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding DealInput.SelectedAssetState, Mode=TwoWay}"
                                              ItemsSource="{Binding DealInput.AssetStates}"
                                              Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                              HorizontalAlignment="Left" Margin="8,0,0,0"/>

                                    <TextBlock Text="Asset Class (AVC)" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding DealInput.SelectedAssetValuationCurve, Mode=TwoWay}"
                                              ItemsSource="{Binding DealInput.AssetValuationCurves}"
                                              Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                              HorizontalAlignment="Left" Margin="8,0,0,0"/>

                                    <TextBlock Text="Credit Rating" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{Binding DealInput.SelectedRating, Mode=TwoWay}"
                                              ItemsSource="{Binding DealInput.CreditRatings}"
                                              Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                              HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                </Grid>
                            </muxc:Expander>

                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Collapse Button positioned at top-right of the column -->
            <Button Command="{Binding DealInput.ToggleDealInputsCollapsedCommand}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="0,18,4,0"
                    Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="100" Style="{StaticResource IconButtonStyle}">
                <Grid>
                    <FontIcon Glyph="&#xE76B;" Foreground="White"
                              Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                   <FontIcon Glyph="&#xE76C;" Foreground="White"
                             Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
               </Grid>
               <ToolTipService.ToolTip>
                   <ToolTip>
                       <StackPanel>
                           <TextBlock Text="Fold in" Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                           <TextBlock Text="Fold out" Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ToolTip>
                </ToolTipService.ToolTip>
            </Button>
        </Grid>

        <controls:GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent" Width="8"
                      Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>

        <!-- MARK: RIGHT - Standard Campaigns, My Campaigns with Responsive Layout -->
        <Grid x:Name="CampaignsGrid" Grid.Row="0" Grid.Column="1" Margin="8,12,8,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MaxHeight="400" MinHeight="200"/>   <!-- Standard Campaigns -->
                <RowDefinition Height="*" MinHeight="200"/> <!-- My Campaigns -->
            </Grid.RowDefinitions>

            <!-- Standard Campaigns with Enhanced Styling -->
            <Border Grid.Row="0" Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Standard Campaigns" Style="{StaticResource CardHeaderTextStyle}">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Pre-configured campaign templates" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ResponsiveScrollViewer}">
                        <controls:DataGrid x:Name="StandardGrid"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           ItemsSource="{Binding CampaignManager.StandardCampaigns}"
                                           SelectedItem="{Binding CampaignManager.SelectedCampaign, Mode=TwoWay}"
                                           SelectionMode="Single"
                                           HeadersVisibility="Column"
                                           CanUserSortColumns="False"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="False"
                                           AutoGenerateColumns="False"
                                            IsReadOnly="True"
                                            GridLinesVisibility="All"
                                            MinHeight="150" DoubleTapped="OnStandardGridDoubleTapped">

                            <controls:DataGrid.RowStyle>
                                <Style TargetType="controls:DataGridRow">
                                    <Setter Property="ToolTipService.ToolTip" Value="Double-click a campaign to add it to My Campaigns"/>
                                </Style>
                            </controls:DataGrid.RowStyle>
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Campaign Name" Binding="{Binding Title}" Width="200">
                                    <controls:DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </controls:DataGridTextColumn.ElementStyle>
                                </controls:DataGridTextColumn>
                                <controls:DataGridTextColumn Header="Monthly Installment" Binding="{Binding Monthly}" Width="140"/>
                                <controls:DataGridTextColumn Header="Transaction Price" Binding="{Binding TransactionPrice}" Width="140"/>
                                <controls:DataGridTextColumn Header="Cash Discount" Binding="{Binding CashDiscount}" Width="120"/>
                                <controls:DataGridTextColumn Header="Customer Downpayment" Binding="{Binding Downpayment}" Width="120"/>
                                <controls:DataGridTextColumn Header="Dealer Comm." Binding="{Binding DealerCommission}" Width="140"/>
                                <controls:DataGridTextColumn Header="Acq. RoRAC" Binding="{Binding RoRAC}" Width="120"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- My Campaigns with Enhanced Controls -->
            <Border Grid.Row="1" Style="{StaticResource CardContainerStyle}" Margin="0,0,0,8" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="My Campaigns" Style="{StaticResource CardHeaderTextStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Your custom campaign configurations" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <Button Content="+ New Bank Campaign"
                                Command="{Binding NewBankCampaignCommand}"
                                Margin="12,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Create a new bank campaign" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Content="Load Campaigns"
                                Command="{Binding LoadCampaignsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Load saved campaigns from file" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Content="Save All Changes"
                                Command="{Binding SaveAllCampaignsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Save all campaign changes" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Content="Clear Campaigns"
                                Command="{Binding ClearCampaignsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Clear all campaigns (requires confirmation)" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ResponsiveScrollViewer}">
                        <controls:DataGrid x:Name="MyGrid"
                                           ItemsSource="{Binding CampaignManager.MyCampaigns}"
                                           SelectedItem="{Binding CampaignManager.SelectedMyCampaign, Mode=TwoWay}"
                                           SelectionMode="Single"
                                           HeadersVisibility="Column"
                                           CanUserSortColumns="False"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="False"
                                           AutoGenerateColumns="False"
                                           IsReadOnly="False"
                                           GridLinesVisibility="All"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           MinHeight="150">
                            <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Campaign Name" Binding="{Binding Title, Mode=TwoWay}" Width="200">
                                <controls:DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </controls:DataGridTextColumn.ElementStyle>
                            </controls:DataGridTextColumn>
                            <controls:DataGridTextColumn Header="Monthly Installment" Binding="{Binding Monthly}" Width="140" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Transaction Price" Binding="{Binding TransactionPrice}" Width="140" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Cash Discount" Binding="{Binding CashDiscount}" Width="120" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Customer Downpayment" Binding="{Binding Downpayment}" Width="120" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Dealer Comm." Binding="{Binding DealerCommission}" Width="140" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Acq. RoRAC" Binding="{Binding RoRAC}" Width="120" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Notes" Binding="{Binding Notes, Mode=TwoWay}" Width="220"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <controls:GridSplitter Grid.Column="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Width="8"
                      Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- MARK: RIGHT - Campaign Details with Collapse Toggle -->
        <Grid Grid.Row="0" Grid.Column="3">
            <!-- Campaign Details Content Area -->
            <Border x:Name="CampaignDetailsCard"
                    Margin="12,12,12,12"
                    Padding="16,16,16,16"
                    Style="{StaticResource CardContainerStyle}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding IsCampaignDetailsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              Style="{StaticResource ResponsiveScrollViewer}"
                              Padding="0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Campaign Details &amp; Key Metrics" Style="{StaticResource SectionHeaderTextStyle}"/>
                        <Grid Width="580" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource DetailsLabelColumnWidth}"/>
                                <ColumnDefinition Width="{StaticResource DetailsValueColumnWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Campaign Details -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Campaign Name:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActiveCampaign.Title}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Term (months):" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DealInput.TermMonths}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Financed Amount:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Results.Metrics.FinancedAmount}" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Subsidy budget:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DealInput.SubsidyBudgetText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Subsidy utilized:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActiveSubsidyUtilizedText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Subsidy remaining:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SubsidyRemainingText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="IDC - Dealer Commissions:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DealInput.DealerCommissionResolvedAmtText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="IDC - Others:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding IdcOtherText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="IDC - Free Insurance:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ActiveFsInsuranceText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="IDC - Free MBSP:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ActiveFsMbspText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <!-- Key Metrics -->
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Monthly Installment:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Results.Metrics.MonthlyInstallment}" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Customer Rate (nominal, %):" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Results.Metrics.NominalRate}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Customer Rate (flat, %):" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Results.Metrics.FlatRate}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <TextBlock Grid.Row="13" Grid.Column="0" Text="IDC Total:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding IdcTotalText}" HorizontalAlignment="Left" TextAlignment="Left"/>

                            <!-- MARK: Campaign Designer & Metrics -->
                            <StackPanel Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="Campaign Designer" Style="{StaticResource SectionHeaderTextStyle}"/>

                                <Grid Width="580" HorizontalAlignment="Left" RowSpacing="2" ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource DetailsLabelColumnWidth}"/>
                                        <ColumnDefinition Width="{StaticResource DetailsValueColumnWidth}"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Target Rate (for subinterest) -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Rate (% p.a.)" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <muxc:NumberBox Grid.Row="0" Grid.Column="1" Value="{Binding ActiveCampaign.TargetRatePct, Mode=TwoWay}" Style="{StaticResource CompactNumberBox}"
                                                      NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                      IsEnabled="{Binding IsMyCampaignSelected}" Margin="0"/>

                                    <!-- Cash Discount -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cash Discount (THB)" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <muxc:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding ActiveCampaign.CashDiscountAmount, Mode=TwoWay}" Style="{StaticResource CompactNumberBox}"
                                                      NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                      IsEnabled="{Binding IsMyCampaignSelected}" Margin="0"/>

                                    <!-- Subvention (SubDown) -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Subvention (SubDown) (THB)" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <muxc:NumberBox Grid.Row="2" Grid.Column="1" Value="{Binding ActiveCampaign.FSSubDownAmount, Mode=TwoWay}" Style="{StaticResource CompactNumberBox}"
                                                      NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                      IsEnabled="{Binding IsMyCampaignSelected}" Margin="0"/>

                                    <!-- Free Insurance Cost -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Insurance (THB)" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="3" Grid.Column="1" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <muxc:NumberBox Grid.Column="0" Style="{StaticResource CompactNumberBox}"
                                                        Value="{Binding ActiveCampaign.FSSubInterestAmount, Mode=TwoWay}"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        IsEnabled="{Binding IsMyCampaignSelected}"/>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{Binding ActiveCampaign.IncludeInsurance, Mode=TwoWay}"
                                                      OffContent="Off"
                                                      OnContent="On"
                                                      Margin="8,0,0,0"
                                                      IsEnabled="{Binding IsMyCampaignSelected}"/>
                                    </Grid>
                                    
                                    <!-- MBSP Package -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="MBSP Package" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource CompactComboBox}"
                                              ItemsSource="{Binding ViewModel.DealInput.MbspPackages, ElementName=Root}"
                                              SelectedItem="{Binding ActiveCampaign.SelectedMbspPackage, Mode=TwoWay}"
                                              IsEnabled="{Binding IsMyCampaignSelected}"
                                              HorizontalAlignment="Stretch" Margin="0"/>

                                    <!-- Free MBSP Cost -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="MBSP (THB)" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ActiveCampaign.FSFreeMBSP, Mode=OneWay}" Style="{StaticResource CompactTextBox}"
                                             IsReadOnly="True" Margin="0"/>

                                    <!-- Subinterest Subsidy (ReadOnly, calculated) -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Rate Subsidy (calc.) (THB)" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ActiveCampaign.SubinterestSubsidy}" VerticalAlignment="Center" Margin="0" Opacity="0.8"/>

                                    <!-- Consume Entire Subsidy Toggle -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Consume entire subsidy" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ToggleSwitch Grid.Row="7" Grid.Column="1"
                                                  IsOn="{Binding ActiveCampaign.ConsumeAllSubsidy, Mode=TwoWay}"
                                                  OffContent="Off"
                                                  OnContent="On"
                                                  Margin="0"/>
                                </Grid>

                                <!-- Budget Utilization Visualizer -->
                                <TextBlock Text="Budget Utilization" Style="{StaticResource SectionHeaderTextStyle}" Margin="0,16,0,12"/>
                                <Grid Height="24" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding BudgetUtilization.CashDiscountPct}"/>
                                        <ColumnDefinition Width="{Binding BudgetUtilization.SubDownPct}"/>
                                        <ColumnDefinition Width="{Binding BudgetUtilization.RateSubsidyPct}"/>
                                        <ColumnDefinition Width="{Binding BudgetUtilization.IdcPct}"/>
                                        <ColumnDefinition Width="{Binding BudgetUtilization.UnallocatedPct}"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Using rectangles for segments, colors should be defined in resources optimally, using hardcoded for now -->
                                    <Rectangle Grid.Column="0" Fill="#FF0078D7" ToolTipService.ToolTip="Cash Discount"/>
                                    <Rectangle Grid.Column="1" Fill="#FF0099BC" ToolTipService.ToolTip="SubDown"/>
                                    <Rectangle Grid.Column="2" Fill="#FF00B7C3" ToolTipService.ToolTip="Rate Subsidy"/>
                                    <Rectangle Grid.Column="3" Fill="#FF038387" ToolTipService.ToolTip="Other Campaign IDCs (Insurance/MBSP)"/>
                                    <Rectangle Grid.Column="4" Fill="#FF737373" ToolTipService.ToolTip="Unallocated"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4"><Rectangle Width="12" Height="12" Fill="#FF0078D7"/><TextBlock Text="Cash Disc." FontSize="11"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4"><Rectangle Width="12" Height="12" Fill="#FF0099BC"/><TextBlock Text="SubDown" FontSize="11"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4"><Rectangle Width="12" Height="12" Fill="#FF00B7C3"/><TextBlock Text="Rate Sub." FontSize="11"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4"><Rectangle Width="12" Height="12" Fill="#FF038387"/><TextBlock Text="IDCs" FontSize="11"/></StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4"><Rectangle Width="12" Height="12" Fill="#FF737373"/><TextBlock Text="Unallocated" FontSize="11"/></StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <ToggleButton Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RoRACDetailsToggle2" HorizontalAlignment="Left" Margin="0,16,0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Acquisition RoRAC:" Style="{StaticResource LabelTextStyle}"/>
                                    <TextBlock Text="{Binding Results.Metrics.RoRAC}" FontWeight="SemiBold"/>
                                    <TextBlock Text="(show details)" Opacity="0.7" FontSize="11"/>
                                </StackPanel>
                            </ToggleButton>
                            
                            <Grid Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2" x:Name="RoRACDetailsGrid2"
                                  Visibility="{Binding IsChecked, ElementName=RoRACDetailsToggle2, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Margin="0,8,0,8">
                                <Border BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- 0 -->
                                            <RowDefinition Height="Auto"/> <!-- 1 -->
                                            <RowDefinition Height="Auto"/> <!-- 2 -->
                                            <RowDefinition Height="Auto"/> <!-- 3 -->
                                            <RowDefinition Height="Auto"/> <!-- 4 -->
                                            <RowDefinition Height="Auto"/> <!-- 5 -->
                                            <RowDefinition Height="Auto"/> <!-- 6 -->
                                            <RowDefinition Height="Auto"/> <!-- 7 -->
                                            <RowDefinition Height="Auto"/> <!-- 8 -->
                                            <RowDefinition Height="Auto"/> <!-- 9 -->
                                            <RowDefinition Height="Auto"/> <!-- 10 -->
                                            <RowDefinition Height="Auto"/> <!-- 11 separator -->
                                            <RowDefinition Height="Auto"/> <!-- 12 -->
                                            <RowDefinition Height="Auto"/> <!-- 13 -->
                                            <RowDefinition Height="Auto"/> <!-- 14 -->
                                            <RowDefinition Height="Auto"/> <!-- 15 -->
                                            <RowDefinition Height="Auto"/> <!-- 16 separator -->
                                            <RowDefinition Height="Auto"/> <!-- 17 -->
                                        </Grid.RowDefinitions>

                                        <!-- RoRAC Waterfall -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer Rate:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WfCustomerRateText}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="IDC (annualized):" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WfIDCUpfrontAnnualizedText}"/>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Subsidy (annualized):" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WfSubsidyUpfrontAnnualizedText}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="= Deal IRR (Nominal):" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WfDealIRRNominalText}" FontWeight="SemiBold"/>
                                        
                                        <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,4"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Matched Funded Rate:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding WfCostOfDebtMatchedText}"/>
                                        
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Matched Funded Spread:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding WfMatchedFundedSpreadText}"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="= Net Interest Margin:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding WfNetInterestMarginText}" FontWeight="SemiBold"/>

                                        <Border Grid.Row="8" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,4"/>

                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="Cost of Credit Risk:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding WfCostOfCreditRiskText}"/>
                                        
                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="OPEX:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding WfOPEXText}"/>
                                        
                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="Capital Advantage:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding WfCapitalAdvantageText}"/>

                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="= Net EBIT Margin:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding WfNetEBITMarginText}" FontWeight="SemiBold"/>

                                        <Border Grid.Row="13" Grid.ColumnSpan="2" Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,4,0,4"/>

                                        <TextBlock Grid.Row="14" Grid.Column="0" Text="Economic Capital:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding WfEconomicCapitalText}"/>
                                        
                                        <TextBlock Grid.Row="15" Grid.Column="0" Text="= Acquisition RoRAC:" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="15" Grid.Column="1" Text="{Binding Results.Metrics.RoRAC}" FontWeight="ExtraBold"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Button Grid.Row="17" Grid.Column="1"
                                    Command="{Binding ExportXlsxCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                    <TextBlock Text="Export XLSX"/>
                                </StackPanel>
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="Export data to Excel file" Style="{StaticResource InformativeToolTipStyle}"/>
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Collapse Button positioned at top-left of the column -->
            <Button Command="{Binding ToggleCampaignDetailsCollapsedCommand}"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Margin="4,18,0,0"
                    Background="{ThemeResource SystemControlBackgroundBaseMediumBrush}"
                    BorderBrush="{ThemeResource CardStrokeBrush}"
                    BorderThickness="1"
                    Canvas.ZIndex="100" Style="{StaticResource IconButtonStyle}">
                <Grid>
                    <FontIcon Glyph="&#xE76C;" Foreground="White"
                              Visibility="{Binding IsCampaignDetailsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" />
                    <FontIcon Glyph="&#xE76B;" Foreground="White"
                              Visibility="{Binding IsCampaignDetailsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
                <ToolTipService.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="Fold out" Visibility="{Binding IsCampaignDetailsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            <TextBlock Text="Fold in" Visibility="{Binding IsCampaignDetailsCollapsed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ToolTip>
                </ToolTipService.ToolTip>
            </Button>
        </Grid>
                    <!-- MARK: FOOTER -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="Transparent" Padding="12,8" Margin="12,0,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorStatus}"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           Style="{StaticResource StatusTextStyle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8A2;" FontSize="14"/>
                            <TextBlock Text="Export PDF"/>
                        </StackPanel>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Export report as PDF" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save Scenario"/>
                        </StackPanel>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Save current scenario for later" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <Button Command="{Binding AddToComparisonCommand}" Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Add to Comparison"/>
                        </StackPanel>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Add current deal to comparison tab" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</TabViewItem>
            
            <!-- MARK: Cashflows Tab with Icon -->
            <TabViewItem IsClosable="False" Style="{StaticResource IconTabViewItemStyle}">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                        <TextBlock Text="Cashflows" VerticalAlignment="Center"/>
                        <!-- Refresh indicator -->
                        <Border x:Name="CashflowRefreshIndicator"
                                Background="{ThemeResource WarningBrush}"
                                CornerRadius="4"
                                Width="8"
                                Height="8"
                                Visibility="{Binding CashflowNeedsRefresh, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Cashflow data needs refresh" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Border>
                    </StackPanel>
                </TabViewItem.Header>
                <Grid Background="Transparent" Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with export button and campaign info -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cashflow Schedule" Style="{StaticResource CardHeaderTextStyle}" FontSize="24"/>
                            <TextBlock Text="{Binding Results.CashflowCampaignName}" FontSize="14" Opacity="0.8" Margin="0,4,0,0"/>

                            <!-- Campaign-level Cashflow Adjustments -->
                            <muxc:Expander Header="Cashflow Adjustments (campaign)" IsExpanded="False" Margin="0,8,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Payment holiday (capitalized; unchanged maturity)" Style="{StaticResource LabelTextStyle}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Holiday 3m" Command="{Binding ActiveCampaign.AddHoliday3Command}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="Holiday 6m" Command="{Binding ActiveCampaign.AddHoliday6Command}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="Holiday 9m" Command="{Binding ActiveCampaign.AddHoliday9Command}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="Clear" Command="{Binding ActiveCampaign.ClearHolidaysCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>

                                    <!-- Manual selector -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="From" VerticalAlignment="Center"/>
                                        <muxc:NumberBox Minimum="1" Maximum="600"
                                                        Value="{Binding ActiveCampaign.HolidayStart, Mode=TwoWay}"
                                                        Width="80" Style="{StaticResource CompactNumberBox}"/>
                                        <TextBlock Text="Months" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <muxc:NumberBox Minimum="1" Maximum="600"
                                                        Value="{Binding ActiveCampaign.HolidayMonths, Mode=TwoWay}"
                                                        Width="80" Style="{StaticResource CompactNumberBox}"/>
                                        <Button Content="Apply" Command="{Binding ActiveCampaign.AddHolidayCustomCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ActiveCampaign.HolidayError}" Foreground="Red"/>

                                    <TextBlock Text="Active Holidays" Style="{StaticResource LabelTextStyle}" />
                                    <Border BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                        <ItemsControl ItemsSource="{Binding ActiveCampaign.PaymentHolidays}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="Periods "/>
                                                        <Run Text="{Binding StartPeriod}"/>
                                                        <Run Text="-"/>
                                                        <Run Text="{Binding EndPeriod}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding RuleId}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </muxc:Expander>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding ExportXlsxCommand}"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                <TextBlock Text="Export XLSX"/>
                            </StackPanel>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Export cashflow data to Excel" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>
                    
                    <!-- Enhanced Cashflow Table with Responsive Scrolling -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardContainerStyle}"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            MinHeight="200">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource ResponsiveScrollViewer}">
                            <controls:DataGrid x:Name="CashflowGrid"
                                               ItemsSource="{Binding Results.Cashflows}"
                                               HeadersVisibility="Column"
                                               CanUserSortColumns="True"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               AutoGenerateColumns="False"
                                               IsReadOnly="False"
                                               GridLinesVisibility="All"
                                               VerticalAlignment="Stretch"
                                               HorizontalAlignment="Stretch"
                                               MinHeight="150">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="60"/>
                                    <controls:DataGridTextColumn Header="Payment Type" Binding="{Binding PaymentType}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Cap. Interest" Binding="{Binding CapInterest}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Interest" Binding="{Binding Interest}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Total Payment" Binding="{Binding TotalPayment}" Width="120"/>

                                    <controls:DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Cashflow" Binding="{Binding Cashflow}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Principal Runoff" Binding="{Binding PrincipalRunoff}" Width="130"/>
                                    <controls:DataGridTextColumn Header="Interest Runoff" Binding="{Binding InterestRunoff}" Width="130"/>
                                    <controls:DataGridTextColumn Header="Subsidy Allocation" Binding="{Binding SubsidyAllocation}" Width="130"/>
                                    <controls:DataGridTextColumn Header="IDC Breakdown" Binding="{Binding IdcBreakdown}" Width="120"/>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Summary Totals -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="Gray" BorderThickness="1" Margin="0,8,0,0" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Principal Paid" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding Results.TotalPrincipalPaid}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Interest Paid" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding Results.TotalInterestPaid}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Payments" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding Results.TotalPayments}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- MARK: Campaign Designer Tab with Icon -->
            <TabViewItem IsClosable="False" Style="{StaticResource IconTabViewItemStyle}">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                        <TextBlock Text="Campaign Designer" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabViewItem.Header>
                <Grid Background="Transparent" Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <TextBlock Text="Campaign Designer" Style="{StaticResource CardHeaderTextStyle}" FontSize="24" VerticalAlignment="Center"/>
                        <Button Command="{x:Bind ViewModel.Comparison.ClearComparisonCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                <TextBlock Text="Clear All"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Overall Profitability (Campaign Designer aggregate) -->
                    <Border Style="{StaticResource CardContainerStyle}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Overall Profitability" Style="{StaticResource CardHeaderTextStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.Comparison.OverallAvgRoRAC, Mode=OneWay}"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Portfolio weighted Acquisition RoRAC" Opacity="0.7" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Comparison.DesignerCampaigns, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CampaignTileViewModel">
                                    <Border Style="{StaticResource CardContainerStyle}" Width="360" Padding="12" VerticalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <!-- Header -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Title, Mode=TwoWay}" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Background="Transparent"/>
                                                <!-- Remove (X) button: prompts user and deletes campaign tile -->
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        Click="OnDesignerRemoveClick"
                                                        ToolTipService.ToolTip="Remove campaign">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                            </Grid>

                                            <!-- Basic info -->
                                            <StackPanel Spacing="4">
                                                <!-- Model and Campaign summary -->
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="Model: "/>
                                                    <Run Text="{Binding ModelName}"/>
                                                </TextBlock>
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="Campaign: "/>
                                                    <Run Text="{Binding Title}"/>
                                                </TextBlock>
                                                <!-- Product and Avg RoRAC -->
                                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="Product" Opacity="0.7" FontSize="11"/>
                                                        <TextBlock Text="{Binding Product}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="Avg RoRAC" Opacity="0.7" FontSize="11"/>
                                                        <TextBlock Text="{Binding AvgRoRAC}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Per-term breakdown grid -->
                                            <Border BorderBrush="{ThemeResource CardStrokeBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="Term Breakdown" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,8"/>
                                                    <!-- Column headers -->
                                                    <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Term" Opacity="0.6" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="Rate (% p.a.)" Opacity="0.6" FontSize="12"/>
                                                        <TextBlock Grid.Column="2" Text="Volume Share (%)" Opacity="0.6" FontSize="12"/>
                                                        <TextBlock Grid.Column="3" Text="RoRAC" Opacity="0.6" FontSize="12" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding TermBreakdown}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnSpacing="8" Margin="0,4,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="80"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding TermLabel}" VerticalAlignment="Center"/>
                                                                    <!-- Customer rate editable -->
                                                                    <muxc:NumberBox Grid.Column="1" Value="{Binding CustomerRatePct, Mode=TwoWay}" Minimum="0" Maximum="100" NumberFormatter="{StaticResource GroupedZeroFormatter}" HorizontalAlignment="Stretch" />
                                                                    <!-- Distribution % editable -->
                                                                    <muxc:NumberBox Grid.Column="2" Value="{Binding DistributionPct, Mode=TwoWay}" Minimum="0" Maximum="100" NumberFormatter="{StaticResource GroupedZeroFormatter}" HorizontalAlignment="Stretch" />
                                                                    <!-- Per-term RoRAC -->
                                                                    <TextBlock Grid.Column="3" Text="{Binding RoRAC}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>

                                            <!-- Campaign volume and controls -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Acquisition Units" Opacity="0.7" FontSize="11"/>
                                                    <muxc:NumberBox Value="{Binding CampaignUnits, Mode=TwoWay}" Minimum="0" NumberFormatter="{StaticResource GroupedZeroFormatter}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                    <StackPanel>
                                                        <TextBlock Text="Volume Share (%)" Opacity="0.7" FontSize="11" HorizontalAlignment="Right"/>
                                                        <TextBlock HorizontalAlignment="Right" Text="{Binding CampaignVolumePctText}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,4,0,0">
                                                        <TextBlock Text="Average RoRAC" Opacity="0.7" FontSize="11" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding AvgRoRAC}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>
        </TabView.TabItems>
    </TabView>
</Grid>
</Window>
