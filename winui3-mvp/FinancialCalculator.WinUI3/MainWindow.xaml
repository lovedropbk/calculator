<Window
    x:Class="FinancialCalculator.WinUI3.MainWindow"
    x:Name="Root"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:FinancialCalculator.WinUI3.ViewModels"
    xmlns:appcontrols="using:FinancialCalculator.WinUI3.Controls"
    mc:Ignorable="d"
    Title="Financial Calculator Pro">

    <Grid RequestedTheme="{Binding ViewModel.Settings.Theme, ElementName=Root}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Modifiers="None" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>
        
        <!-- Bottom-right toast for notifications (non-blocking, dismissible) -->
        <Grid x:Name="NotificationToastHost"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              Margin="12"
              Canvas.ZIndex="9999"
              IsHitTestVisible="False">
            <muxc:InfoBar x:Name="NotificationBar"
                          MaxWidth="380"
                          IsOpen="{Binding ViewModel.IsNotificationOpen, ElementName=Root, Mode=TwoWay}"
                          IsClosable="True"
                          Severity="{Binding ViewModel.NotificationSeverity, ElementName=Root}"
                          Title="Notification"
                          Message="{Binding ViewModel.NotificationMessage, ElementName=Root}"
                          Style="{StaticResource NotificationInfoBarStyle}"
                          IsHitTestVisible="True"/>
        </Grid>

        <!-- MARK: Root TabView with Icons -->
        <TabView x:Name="MainTabView"
                 IsAddTabButtonVisible="False"
                 CanDragTabs="False"
                 CanReorderTabs="False"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 Margin="0,0,0,0">


            <!-- MARK: Main Tab with Icon -->
            <TabView.TabItems>
                <TabViewItem IsClosable="False" Style="{StaticResource IconTabViewItemStyle}">
                    <TabViewItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                            <FontIcon Glyph="&#xE80F;" FontSize="16"/>
                            <TextBlock Text="Main Calculator" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabViewItem.Header>
                <Grid x:Name="LayoutRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" MaxHeight="50"/><!-- Footer -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Left: Deal Input Mask (collapsible) -->
                        <ColumnDefinition x:Name="LeftColumn"
                                          Width="{Binding ViewModel.DealInput.IsDealInputsCollapsed, ElementName=Root, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter='36|1.4*'}"
                                          MinWidth="{Binding ViewModel.DealInput.IsDealInputsCollapsed, ElementName=Root, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='36|560'}"/>
                        <!-- Center: Main content -->
                        <ColumnDefinition Width="3*" MinWidth="480"/>
                        <!-- Grid Splitter -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Right: Campaign Details (collapsible) -->
                        <ColumnDefinition x:Name="RightColumn"
                                          Width="{Binding ViewModel.IsCampaignDetailsCollapsed, ElementName=Root, Converter={StaticResource BoolToGridLengthConverter}, ConverterParameter='36|2*'}"
                                          MinWidth="{Binding ViewModel.IsCampaignDetailsCollapsed, ElementName=Root, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='36|360'}"/>
                    </Grid.ColumnDefinitions>

                    <!-- Overlay pane toggles: visible only when panes are collapsed -->
                    <appcontrols:PaneToggleButton Grid.Row="0" Grid.Column="0"
                                                 HorizontalAlignment="Right"
                                                 Margin="{StaticResource PaneToggleButtonLeftMargin}"
                                                 IsRightSide="False"
                                                 IsCollapsed="{Binding ViewModel.DealInput.IsDealInputsCollapsed, ElementName=Root, Mode=TwoWay}"
                                                 ToggleCommand="{Binding DealInput.ToggleDealInputsCollapsedCommand}"
                                                 Visibility="{Binding ViewModel.DealInput.IsDealInputsCollapsed, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Canvas.ZIndex="1000"/>

                    <appcontrols:PaneToggleButton Grid.Row="0" Grid.Column="3"
                                                 HorizontalAlignment="Left"
                                                 Margin="{StaticResource PaneToggleButtonRightMargin}"
                                                 IsRightSide="True"
                                                 IsCollapsed="{Binding ViewModel.IsCampaignDetailsCollapsed, ElementName=Root, Mode=TwoWay}"
                                                 ToggleCommand="{Binding ToggleCampaignDetailsCollapsedCommand}"
                                                 Visibility="{Binding ViewModel.IsCampaignDetailsCollapsed, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Canvas.ZIndex="1000"/>


        <!-- MARK: LEFT - Deal Input Mask with Collapse Toggle -->
        <Grid Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" RowSpacing="{StaticResource StackedCardSpacing}"
              MaxWidth="{Binding ViewModel.DealInput.IsDealInputsCollapsed, ElementName=Root, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='DealInputsCardMaxWidthCollapsed|DealInputsCardMaxWidthExpanded'}">
            <Grid.RowDefinitions>
                <!-- Top grows to content first (no inner scrolling), bottom fills remainder -->
                <RowDefinition Height="Auto" MinHeight="{StaticResource DealInputsMinHeight}"/>
                <RowDefinition Height="*" MinHeight="{StaticResource GoalSeekMinHeight}"/>
            </Grid.RowDefinitions>
            <!-- Deal Input Content Area -->
            <Border x:Name="DealInputsCard"
                    Margin="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter='DealInputsCardMarginCollapsed|DealInputsCardMarginExpanded'}"
                    Padding="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter='DealInputsCardPaddingCollapsed|DealInputsCardPaddingExpanded'}"
                    Style="{StaticResource CardContainerStyle}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                     Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              HorizontalAlignment="Left"
                              Style="{StaticResource ResponsiveScrollViewer}">
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                            </Style>
                        </Grid.Style>
                        <StackPanel Spacing="{StaticResource SpaceS}">
                
                            <!-- Deal Inputs -->
                            <Grid RowSpacing="{StaticResource FormRowSpacing}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource DetailsLabelColumnWidth}"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Deal Inputs" Style="{StaticResource CardHeaderTextStyle}"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Customer: Risk Settings" Click="OnRiskSettingsClick">
                                        <FontIcon Glyph="&#xE77B;"/>
                                    </Button>
                                </Grid>
        
                                <!-- Vehicle Selection -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Vehicle" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DealInput.AllVehicles}"
                                              SelectedItem="{Binding DealInput.SelectedVehicle, Mode=TwoWay}"
                                              DisplayMemberPath="ModelName"
                                              Style="{StaticResource DenseComboBoxStyle}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Select Class or Model"/>
                                </Grid>

                                <!-- Product (display HP, mySTAR, FL, OL; map to engine tags) -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Product" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DealInput.Product, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource DenseComboBoxStyle}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="HP" Tag="HP"/>
                                        <ComboBoxItem Content="mySTAR" Tag="mySTAR"/>
                                        <ComboBoxItem Content="FL" Tag="F-Lease"/>
                                        <ComboBoxItem Content="OL" Tag="Op-Lease"/>
                                    </ComboBox>
                                </Grid>
        
                                <!-- Term with Tooltip -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Term (months)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Loan term duration in months" Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DealInput.TermMonths, Mode=TwoWay}" Style="{StaticResource DenseComboBoxStyle}" HorizontalAlignment="Stretch">
                                        <x:Int32>12</x:Int32>
                                        <x:Int32>24</x:Int32>
                                        <x:Int32>36</x:Int32>
                                        <x:Int32>48</x:Int32>
                                        <x:Int32>60</x:Int32>
                                        <x:Int32>72</x:Int32>
                                        <x:Int32>84</x:Int32>
                                    </ComboBox>
                                </Grid>
        
                                <!-- Payment Mode (Timing binding) -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Payment Mode" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DealInput.Timing, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource DenseComboBoxStyle}" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="arrears" Tag="arrears"/>
                                        <ComboBoxItem Content="in advance" Tag="advance"/>
                                    </ComboBox>
                                </Grid>
        
                                <!-- MSRP with Tooltip -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="MSRP" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Enter the MSRP excluding tax" Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1">
                                        <muxc:NumberBox Style="{StaticResource DenseNumberBoxStyle}"
                                                        Value="{Binding DealInput.PriceExTax, Mode=TwoWay}"
                                                        PlaceholderText="{Binding DealInput.PricePlaceholder}"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        />
                                        <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                    </Grid>
                                </Grid>

                                <!-- MBTh Discount -->
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="MBTh Discount" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1">
                                        <muxc:NumberBox Style="{StaticResource DenseNumberBoxStyle}"
                                                        Value="{Binding DealInput.MbthDiscount, Mode=TwoWay}"
                                                        PlaceholderText="THB"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        />
                                        <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                    </Grid>
                                </Grid>

                                <!-- Transaction Price (read-only) -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Transaction Price" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1">
                                        <muxc:NumberBox Style="{StaticResource DenseNumberBoxStyle}"
                                                        Value="{Binding DealInput.TransactionPrice}"
                                                        IsEnabled="False"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        />
                                        <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                    </Grid>
                                </Grid>

                                <!-- Additional Financed Items -->
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Additional Financed Items" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1">
                                        <muxc:NumberBox Style="{StaticResource DenseNumberBoxStyle}"
                                                        Value="{Binding DealInput.AdditionalFinancedItems, Mode=TwoWay}"
                                                        PlaceholderText="THB"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        />
                                        <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                    </Grid>
                                </Grid>
         
                                <!-- Down Payment: dual-entry (%, THB) with instant conversion; unit dropdown removed -->
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="Down payment" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Keep column 0 empty to preserve alignment -->
                                    <Grid Grid.Column="1" ColumnSpacing="{StaticResource FormColumnSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- % input with persistent suffix -->
                                        <Grid Grid.Column="0">
                                            <TextBox
                                                Text="{x:Bind ViewModel.DealInput.DownPaymentPctEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="%"
                                                Style="{StaticResource DenseTextBoxWithSuffixStyle}"
                                                Margin="0"
                                                HorizontalAlignment="Stretch"
                                                TextAlignment="Right"
                                                InputScope="Number"/>
                                            <TextBlock Text="%" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource PercentSuffixMargin}"/>
                                        </Grid>

                                        <!-- THB input with persistent suffix -->
                                        <Grid Grid.Column="1">
                                            <muxc:NumberBox
                                                Style="{StaticResource DenseNumberBoxStyle}"
                                                Margin="2,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                Value="{Binding DealInput.DownPaymentAmtEntry, Mode=TwoWay}"
                                                PlaceholderText="THB"
                                                NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                >
                                                <muxc:NumberBox.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Goal Seek: Solve for Down Payment" Command="{Binding GoalSeekSolveForDownPaymentAutoAsyncCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE71A;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </muxc:NumberBox.ContextFlyout>
                                            </muxc:NumberBox>
                                            <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- Balloon: dual-entry (%, THB) with instant conversion; unit dropdown removed -->
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="Balloon" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" HorizontalAlignment="Left" Width="{StaticResource ValueAreaWidth}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Keep column 0 empty to preserve alignment -->
                                    <Grid Grid.Column="1" ColumnSpacing="{StaticResource FormColumnSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- % input with persistent suffix -->
                                        <Grid Grid.Column="0">
                                            <TextBox
                                                Text="{x:Bind ViewModel.DealInput.BalloonPctEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="%"
                                                Style="{StaticResource DenseTextBoxWithSuffixStyle}"
                                                Margin="0"
                                                HorizontalAlignment="Stretch"
                                                TextAlignment="Right"
                                                IsEnabled="{Binding DealInput.IsBalloonEnabled}"
                                                InputScope="Number"/>
                                            <TextBlock Text="%" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource PercentSuffixMargin}"/>
                                        </Grid>

                                        <!-- THB input with persistent suffix -->
                                        <Grid Grid.Column="1">
                                            <muxc:NumberBox
                                                Style="{StaticResource DenseNumberBoxStyle}"
                                                Margin="2,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                Value="{Binding DealInput.BalloonAmtEntry, Mode=TwoWay}"
                                                PlaceholderText="THB"
                                                NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                IsEnabled="{Binding DealInput.IsBalloonEnabled}"/>
                                            <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
        
                                <!-- Subsidy budget with Tooltip (label styled like others) -->
                                <TextBlock Grid.Row="11" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Text="Subsidy budget (THB)" Style="{StaticResource LabelTextStyle}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Available subsidy budget for this deal. Click to solve for target RoRAC." Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <!-- Create a proper overlay structure aligned like single-field rows -->
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                            <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                        </Grid.ColumnDefinitions>
<muxc:NumberBox Grid.Column="1" Style="{StaticResource DenseNumberBoxStyle}" Value="{Binding DealInput.SubsidyBudget, Mode=TwoWay}"
                                                        PlaceholderText="THB"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        IsEnabled="{Binding DealInput.SubsidyBudgetIsEnabled}"
                                                        IsHitTestVisible="{Binding GoalSeek.IsAnyTargetSet, Converter={StaticResource BoolNotConverter}}"
                                                        Minimum="0"
                                                        AcceptsExpression="False"
                                                        >
                                            <muxc:NumberBox.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Goal Seek: Solve for Subsidy (to target RoRAC)" Command="{Binding GoalSeekSolveForSubsidyAutoAsyncCommand}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE71A;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </muxc:NumberBox.ContextFlyout>
                                        </muxc:NumberBox>
                                        <TextBlock Grid.Column="1"
                                                   Text="THB"
                                                   Style="{StaticResource UnitSuffixTextStyle}"
                                                   Margin="{StaticResource CurrencySuffixMargin}"/>
                                        <!-- Overlay button that covers the entire NumberBox -->
                                        <Button Grid.ColumnSpan="2" Command="{Binding GoalSeekSolveForSubsidyAutoAsyncCommand}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Visibility="{Binding GoalSeek.IsAnyTargetSet, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}" BorderThickness="2" Background="Transparent" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="Click to solve for Subsidy Budget to achieve target RoRAC" />
                                            </ToolTipService.ToolTip>
                                        </Button>
                                    </Grid>
                                </Grid>
        
                                <!-- IDCs - Dealer Commission -->
                                <TextBlock Grid.Row="12" Grid.Column="0" Text="IDCs – Commission" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Grid Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" HorizontalAlignment="Left" Width="{StaticResource ValueAreaWidth}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Unit dropdown removed; column preserved for alignment -->

                                    <Grid Grid.Column="1" ColumnSpacing="{StaticResource FormColumnSpacing}"
                                          Visibility="{Binding DealInput.IsCommissionEditorVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- % input with persistent suffix -->
                                        <Grid Grid.Column="0">
                                            <TextBox
                                                Text="{x:Bind ViewModel.DealInput.CommissionPctEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="%"
                                                Style="{StaticResource DenseTextBoxWithSuffixStyle}"
                                                Margin="0"
                                                HorizontalAlignment="Stretch"
                                                TextAlignment="Right"
                                                InputScope="Number"/>
                                            <TextBlock Text="%" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource PercentSuffixMargin}"/>
                                        </Grid>

                                        <!-- THB input with persistent suffix -->
                                        <Grid Grid.Column="1">
                                            <muxc:NumberBox
                                                Style="{StaticResource DenseNumberBoxStyle}"
                                                Margin="2,0,0,0"
                                                HorizontalAlignment="Stretch"
                                                Value="{Binding DealInput.CommissionAmtEntry, Mode=TwoWay}"
                                                PlaceholderText="THB"
                                                NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                />
                                            <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                        </Grid>
                                    </Grid>

                                    <!-- Summary pill in same row when editor hidden (align with value column) -->
                                    <Border Grid.Column="1"
                                            Style="{StaticResource PillBorderStyle}"
                                            Visibility="{Binding DealInput.IsCommissionEditorVisible, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                                <TextBlock>
                                                    <Run Text="{Binding DealInput.DealerCommissionMode}"/>
                                                    <Run Text=": "/>
                                                    <Run Text="{Binding DealInput.DealerCommissionPctText}"/>
                                                    <Run Text="% ("/>
                                                    <Run Text="{Binding DealInput.DealerCommissionResolvedAmtText}"/>
                                                    <Run Text=" THB)"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Command="{Binding DealInput.ShowCommissionEditorCommand}" />
                                        </Grid>
                                    </Border>
                                </Grid>
        
        
                                <!-- IDCs - Other with Tooltip -->
                                <TextBlock Grid.Row="14" Grid.Column="0" Text="IDCs – Other (THB)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="Other indirect costs" Style="{StaticResource InformativeToolTipStyle}"/>
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                                <Grid Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1">
                                        <muxc:NumberBox Style="{StaticResource DenseNumberBoxStyle}"
                                                        Value="{Binding DealInput.IdcOther, Mode=TwoWay}"
                                                        PlaceholderText="THB"
                                                        NumberFormatter="{StaticResource GroupedZeroFormatter}"
                                                        />
                                        <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                                    </Grid>
                                </Grid>
        
                                <!-- Customer rate -->
                                <TextBlock Grid.Row="16" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0"
                                           Text="Customer rate (% p.a.)"
                                           Style="{StaticResource LabelTextStyle}"/>
                                <Grid Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left" Style="{StaticResource DetailsGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="1" ColumnSpacing="{StaticResource FormColumnSpacing}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Nominal rate input (with in-field label and goal-seek overlay) -->
                                        <Grid Grid.Column="0">
                                            <muxc:NumberBox
                                                Value="{x:Bind ViewModel.DealInput.CustomerNominalRate, Mode=TwoWay}"
                                                Minimum="0"
                                                Maximum="100"
                                                Style="{StaticResource DenseNumberBoxWithLabel52Style}"
                                                NumberFormatter="{StaticResource GroupedTwoFormatter}"
                                                IsEnabled="{Binding GoalSeek.IsAnyTargetSet, Converter={StaticResource BoolNotConverter}}">
                                                <muxc:NumberBox.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Goal Seek: Solve for Rate (to target RoRAC)" Command="{Binding GoalSeekSolveForRateAutoAsyncCommand}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE71A;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </muxc:NumberBox.ContextFlyout>
                                            </muxc:NumberBox>
                                            <TextBlock Text="nominal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" FontSize="12" IsHitTestVisible="False"/>
                                            <TextBlock Text="%" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource PercentSuffixMargin}"/>
                                            <Button Command="{Binding GoalSeekSolveForRateAutoAsyncCommand}"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                     Visibility="{Binding GoalSeek.IsAnyTargetSet, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}" BorderThickness="2" Background="Transparent" CornerRadius="4">
                                                            <ToolTipService.ToolTip>
                                                                <ToolTip Content="Click to solve for Customer Rate to achieve target RoRAC" />
                                                            </ToolTipService.ToolTip>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- Flat rate input (with in-field label) -->
                                        <Grid Grid.Column="1">
                                            <muxc:NumberBox
                                                Value="{x:Bind ViewModel.DealInput.CustomerFlatRate, Mode=TwoWay}"
                                                Minimum="0"
                                                Maximum="100"
                                                Style="{StaticResource DenseNumberBoxWithLabel40Style}"
                                                NumberFormatter="{StaticResource GroupedTwoFormatter}"/>
                                            <TextBlock Text="flat" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" FontSize="12" IsHitTestVisible="False"/>
                                            <TextBlock Text="%" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource PercentSuffixMargin}"/>
                                        </Grid>

                                        <!-- Deviation warning -->
                                        <FontIcon Grid.Column="2" Glyph="&#xE7BA;" Foreground="{ThemeResource WarningBrush}"
                                                  Visibility="{Binding DealInput.IsRateDeviation, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Margin="{StaticResource LabelToValueMargin}" VerticalAlignment="Center">
                                            <ToolTipService.ToolTip>
                                                <ToolTip Content="Rate deviates from standard" Style="{StaticResource InformativeToolTipStyle}"/>
                                            </ToolTipService.ToolTip>
                                        </FontIcon>
                                    </Grid>
                                </Grid>
        
                                <!-- Target installment (visible if target installment) -->
                                <TextBlock Grid.Row="18" Grid.Column="0" Text="Target installment (THB)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Visibility="{Binding DealInput.IsTargetInstallmentMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=True}"/>
                                <Grid Grid.Row="18" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left"
                                      Visibility="{Binding DealInput.IsTargetInstallmentMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=True}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                        <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="1" Text="{Binding DealInput.TargetInstallment, Mode=TwoWay}" Style="{StaticResource DenseTextBoxStyle}" HorizontalAlignment="Stretch"/>
                                </Grid>
        
                                <!-- Loading indicator (no status text; hidden when idle) -->
                                <StackPanel Grid.Row="19" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="{StaticResource SpaceM}" Margin="8,16,0,0"
                                            Visibility="{Binding IsCalculating, Converter={StaticResource BoolToVisibilityConverter}}">
                                     <ProgressRing x:Name="CalculationProgress"
                                                   IsActive="{Binding IsCalculating}"
                                                   Width="20"
                                                   Height="20"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>



                            <!-- Cashflow adjustments moved to Cashflows tab -->

                            <!-- Risk Parameters Expander -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource DetailsLabelColumnWidth}"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                                    <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                                </Grid.ColumnDefinitions>

                            </Grid>

                        </StackPanel>
                    </Grid>
</ScrollViewer>
            </Border>

            <Border Grid.Row="1"
                    Margin="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter='GoalSeekCardMarginCollapsed|GoalSeekCardMarginExpanded'}"
                    Padding="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter='GoalSeekCardPaddingCollapsed|GoalSeekCardPaddingExpanded'}"
                    Style="{StaticResource CardContainerStyle}"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                <Grid RowSpacing="{StaticResource FormRowSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource DetailsLabelColumnWidth}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Goal Seek" Style="{StaticResource CardHeaderTextStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Target RoRAC (%)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                            <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1">
                            <muxc:NumberBox Style="{StaticResource DenseNumberBoxStyle}"
                                            Value="{Binding GoalSeek.TargetRoRac, Mode=TwoWay}"
                                            Minimum="0"
                                            Maximum="100"
                                            SmallChange="0.1"
                                            LargeChange="1"
                                            PlaceholderText="%"
                                            NumberFormatter="{StaticResource GroupedTwoFormatter}"/>
                            <TextBlock Text="%" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource PercentSuffixMargin}"/>
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Target installment (THB)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="{StaticResource LabelToValueMargin}" Width="{StaticResource ValueAreaWidth}" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource UnitColumnWidthValue}"/>
                            <ColumnDefinition Width="{StaticResource InputColumnWidthValue}"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1">
                            <muxc:NumberBox Style="{StaticResource DenseNumberBoxStyle}"
                                            Value="{Binding GoalSeek.TargetInstallment, Mode=TwoWay}"
                                            Minimum="0"
                                            SmallChange="100"
                                            LargeChange="1000"
                                            PlaceholderText="THB"
                                            NumberFormatter="{StaticResource GroupedZeroFormatter}"/>
                            <TextBlock Text="THB" Style="{StaticResource UnitSuffixTextStyle}" Margin="{StaticResource CurrencySuffixMargin}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Collapse Button positioned at top-right of the column -->
            <appcontrols:PaneToggleButton
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="{StaticResource PaneToggleButtonLeftMargin}"
                    Canvas.ZIndex="1000"
                    IsRightSide="False"
                    IsCollapsed="{Binding DealInput.IsDealInputsCollapsed, Mode=TwoWay}"
                    ToggleCommand="{Binding DealInput.ToggleDealInputsCollapsedCommand}"
                    Visibility="{Binding DealInput.IsDealInputsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
        </Grid>

        <controls:GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndCurrent" Width="{StaticResource SpaceXS}"
                      Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>

        <!-- MARK: RIGHT - Standard Campaigns, My Campaigns with Responsive Layout -->
        <Grid x:Name="CampaignsGrid" Grid.Row="0" Grid.Column="1" Margin="{StaticResource MainTwoPaneContentMargin}" RowSpacing="{StaticResource StackedCardSpacing}">
            <Grid.RowDefinitions>
                <!-- Content-first then fill: top (Standard) grows to content up to MaxHeight, bottom (My Campaigns) fills rest -->
                <RowDefinition Height="Auto" MinHeight="{StaticResource CenterTopMinHeight}"/>
                <RowDefinition Height="*" MinHeight="{StaticResource CenterBottomMinHeight}"/>
            </Grid.RowDefinitions>

            <!-- Standard Campaigns with Enhanced Styling -->
            <Border Grid.Row="0" Style="{StaticResource CardContainerStyle}" Margin="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Standard Campaigns" Style="{StaticResource CardHeaderTextStyle}">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Pre-configured campaign templates" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                    <ScrollViewer Grid.Row="1" MaxHeight="{StaticResource CenterTopMaxHeight}"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ResponsiveScrollViewer}">
                        <controls:DataGrid x:Name="StandardGrid" Style="{StaticResource ModernDataGridStyle}"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           ItemsSource="{Binding CampaignManager.StandardCampaigns}"
                                           SelectedItem="{Binding CampaignManager.SelectedCampaign, Mode=TwoWay}"
                                           SelectionMode="Single"
                                           HeadersVisibility="Column"
                                           CanUserSortColumns="False"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="False"
                                           AutoGenerateColumns="False"
                                            IsReadOnly="True"
                                            GridLinesVisibility="All"
                                            MinHeight="{StaticResource CenterTopMinHeight}" DoubleTapped="OnStandardGridDoubleTapped">

                            <controls:DataGrid.RowStyle>
                                <Style TargetType="controls:DataGridRow">
                                    <Setter Property="ToolTipService.ToolTip" Value="Double-click a campaign to add it to My Campaigns"/>
                                </Style>
                            </controls:DataGrid.RowStyle>
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="Campaign Name" Binding="{Binding Title}" Width="200">
                                    <controls:DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="NoWrap"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </controls:DataGridTextColumn.ElementStyle>
                                </controls:DataGridTextColumn>
                                <controls:DataGridTextColumn Header="Monthly Installment" Binding="{Binding Monthly}" Width="140"/>
                                <controls:DataGridTextColumn Header="Transaction Price" Binding="{Binding TransactionPrice}" Width="140"/>
                                <controls:DataGridTextColumn Header="Cash Discount" Binding="{Binding CashDiscount}" Width="120"/>
                                <controls:DataGridTextColumn Header="Customer Downpayment" Binding="{Binding Downpayment}" Width="120"/>
                                <controls:DataGridTextColumn Header="Dealer Comm." Binding="{Binding DealerCommission}" Width="140"/>
                                <controls:DataGridTextColumn Header="Acq. RoRAC" Binding="{Binding RoRAC}" Width="120"/>
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- My Campaigns with Enhanced Controls -->
            <Border Grid.Row="1" Style="{StaticResource CardContainerStyle}" Margin="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <TextBlock Text="My Campaigns" Style="{StaticResource CardHeaderTextStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Your custom campaign configurations" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <Button Content="+ New Bank Campaign"
                                Command="{Binding NewBankCampaignCommand}"
                                Margin="12,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Create a new bank campaign" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Content="Load Campaigns"
                                Command="{Binding LoadCampaignsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Load saved campaigns from file" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Content="Save All Changes"
                                Command="{Binding SaveAllCampaignsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Save all campaign changes" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                        <Button Content="Clear Campaigns"
                                Command="{Binding ClearCampaignsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Clear all campaigns (requires confirmation)" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ResponsiveScrollViewer}">
                        <controls:DataGrid x:Name="MyGrid" Style="{StaticResource ModernDataGridStyle}"
                                           ItemsSource="{Binding CampaignManager.MyCampaigns}"
                                           SelectedItem="{Binding CampaignManager.SelectedMyCampaign, Mode=TwoWay}"
                                           SelectionMode="Single"
                                           HeadersVisibility="Column"
                                           CanUserSortColumns="False"
                                           CanUserReorderColumns="False"
                                           CanUserResizeColumns="False"
                                           AutoGenerateColumns="False"
                                           IsReadOnly="False"
                                           GridLinesVisibility="All"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           MinHeight="{StaticResource CenterBottomMinHeight}">
                            <controls:DataGrid.Columns>
                            <controls:DataGridTextColumn Header="Campaign Name" Binding="{Binding Title, Mode=TwoWay}" Width="200">
                                <controls:DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </controls:DataGridTextColumn.ElementStyle>
                            </controls:DataGridTextColumn>
                            <controls:DataGridTextColumn Header="Monthly Installment" Binding="{Binding Monthly}" Width="140" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Transaction Price" Binding="{Binding TransactionPrice}" Width="140" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Cash Discount" Binding="{Binding CashDiscount}" Width="120" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Customer Downpayment" Binding="{Binding Downpayment}" Width="120" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Dealer Comm." Binding="{Binding DealerCommission}" Width="140" IsReadOnly="True"/>
                            <controls:DataGridTextColumn Header="Acq. RoRAC" Binding="{Binding RoRAC}" Width="120" IsReadOnly="True"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>
                </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <controls:GridSplitter Grid.Column="2" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Width="{StaticResource SpaceXS}"
                      Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- MARK: RIGHT - Campaign Details with Collapse Toggle -->
        <Grid Grid.Row="0" Grid.Column="3">
            <appcontrols:CampaignDetailsView DataContext="{Binding}"/>
            <!-- Collapse Button positioned at top-left of the column -->
            <appcontrols:PaneToggleButton
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="{StaticResource PaneToggleButtonRightMargin}"
                    Canvas.ZIndex="1000"
                    IsRightSide="True"
                    IsCollapsed="{Binding IsCampaignDetailsCollapsed, Mode=TwoWay}"
                    ToggleCommand="{Binding ToggleCampaignDetailsCollapsedCommand}"
                    Visibility="{Binding IsCampaignDetailsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
        </Grid>
                    <!-- MARK: FOOTER -->
         <Border Grid.Row="1" Grid.ColumnSpan="4" Background="Transparent" Padding="12,8" Margin="12,0,12,12">
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorStatus}"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           Style="{StaticResource StatusTextStyle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                    <Button Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSPlus}">
                            <FontIcon Glyph="&#xE8A2;" FontSize="14"/>
                            <TextBlock Text="Export PDF"/>
                        </StackPanel>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Export report as PDF" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSPlus}">
                            <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                            <TextBlock Text="Save Scenario"/>
                        </StackPanel>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Save current scenario for later" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </Button>
                    <Button Command="{Binding AddToComparisonCommand}" Style="{StaticResource SecondaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSPlus}">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="Add to Comparison"/>
                        </StackPanel>
                        <ToolTipService.ToolTip>
                            <ToolTip Content="Add current deal to comparison tab" Style="{StaticResource InformativeToolTipStyle}"/>
                        </ToolTipService.ToolTip>
                    </Button>
                        <Button x:Name="AppSettingsButtonFooter" Style="{StaticResource SecondaryButtonStyle}" Click="OnAppSettingsClick">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSPlus}">
                                <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout >
                                    <!-- Behavior group -->
                                    <MenuFlyoutSubItem x:Uid="AppSettings_Behavior" Text="App behavior">
                                        <MenuFlyoutSubItem x:Uid="AppSettings_Language" Text="Language">
                                            <RadioMenuFlyoutItem GroupName="Language" Text="English" IsChecked="{Binding ViewModel.Settings.LanguageTag, ElementName=Root, Converter={StaticResource StringEqualsConverter}, ConverterParameter=en-US}" Click="OnLanguageEnglishClicked"/>
                                            <RadioMenuFlyoutItem GroupName="Language" Text="ไทย" IsChecked="{Binding ViewModel.Settings.LanguageTag, ElementName=Root, Converter={StaticResource StringEqualsConverter}, ConverterParameter=th-TH}" Click="OnLanguageThaiClicked"/>
                                        </MenuFlyoutSubItem>
                                        <ToggleMenuFlyoutItem x:Name="AutoExpandToggle" Text="Auto expand right when left collapses" IsChecked="{Binding ViewModel.Settings.AutoExpandRightOnLeftCollapse, ElementName=Root, Mode=TwoWay}"/>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator/>
                                    <!-- Display group (Fluent v2 radios for exclusive choices) -->
                                    <MenuFlyoutSubItem x:Uid="AppSettings_Theme" Text="Theme">
                                        <RadioMenuFlyoutItem GroupName="Theme" Text="System default" IsChecked="{Binding ViewModel.Settings.IsThemeDefault, ElementName=Root, Mode=TwoWay}"/>
                                        <RadioMenuFlyoutItem GroupName="Theme" Text="Light" IsChecked="{Binding ViewModel.Settings.IsThemeLight, ElementName=Root, Mode=TwoWay}"/>
                                        <RadioMenuFlyoutItem GroupName="Theme" Text="Dark" IsChecked="{Binding ViewModel.Settings.IsThemeDark, ElementName=Root, Mode=TwoWay}"/>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem x:Uid="AppSettings_Density" Text="Density">
                                        <RadioMenuFlyoutItem GroupName="Density" Text="Compact" IsChecked="{Binding ViewModel.Settings.IsDensityCompact, ElementName=Root, Mode=TwoWay}"/>
                                        <RadioMenuFlyoutItem GroupName="Density" Text="Comfortable" IsChecked="{Binding ViewModel.Settings.IsDensityComfortable, ElementName=Root, Mode=TwoWay}"/>
                                    </MenuFlyoutSubItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

    </Grid>
</TabViewItem>
            
            <!-- MARK: Cashflows Tab with Icon -->
            <TabViewItem IsClosable="False" Style="{StaticResource IconTabViewItemStyle}">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                        <TextBlock Text="Cashflows" VerticalAlignment="Center"/>
                        <!-- Refresh indicator -->
                        <Border x:Name="CashflowRefreshIndicator"
                                Background="{ThemeResource WarningBrush}"
                                CornerRadius="4"
                                Width="8"
                                Height="8"
                                Visibility="{Binding CashflowNeedsRefresh, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Cashflow data needs refresh" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Border>
                    </StackPanel>
                </TabViewItem.Header>
                <Grid Background="Transparent" Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with export button and campaign info -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Cashflow Schedule" Style="{StaticResource CardHeaderTextStyle}" FontSize="24"/>
                            <TextBlock Text="{Binding Results.CashflowCampaignName}" FontSize="14" Opacity="0.8" Margin="0,4,0,0"/>

                            <!-- Campaign-level Cashflow Adjustments -->
                            <muxc:Expander Header="Cashflow Adjustments (campaign)" IsExpanded="False" Margin="0,8,0,0">
                                <StackPanel Spacing="{StaticResource SpaceS}">
                                    <TextBlock Text="Payment holiday (capitalized; unchanged maturity)" Style="{StaticResource LabelTextStyle}"/>

                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                        <Button Content="Holiday 3m" Command="{Binding ActiveCampaign.AddHoliday3Command}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="Holiday 6m" Command="{Binding ActiveCampaign.AddHoliday6Command}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="Holiday 9m" Command="{Binding ActiveCampaign.AddHoliday9Command}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Content="Clear" Command="{Binding ActiveCampaign.ClearHolidaysCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>

                                    <!-- Manual selector -->
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                                        <TextBlock Text="From" VerticalAlignment="Center"/>
                                        <muxc:NumberBox Minimum="1" Maximum="600"
                                                        Value="{Binding ActiveCampaign.HolidayStart, Mode=TwoWay}"
                                                        Width="80" Style="{StaticResource DenseNumberBoxStyle}"/>
                                        <TextBlock Text="Months" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <muxc:NumberBox Minimum="1" Maximum="600"
                                                        Value="{Binding ActiveCampaign.HolidayMonths, Mode=TwoWay}"
                                                        Width="80" Style="{StaticResource DenseNumberBoxStyle}"/>
                                        <Button Content="Apply" Command="{Binding ActiveCampaign.AddHolidayCustomCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ActiveCampaign.HolidayError}" Foreground="{ThemeResource ErrorBrush}"/>

                                    <TextBlock Text="Active Holidays" Style="{StaticResource LabelTextStyle}" />
                                    <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                                        <ItemsControl ItemsSource="{Binding ActiveCampaign.PaymentHolidays}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="Periods "/>
                                                        <Run Text="{Binding StartPeriod}"/>
                                                        <Run Text="-"/>
                                                        <Run Text="{Binding EndPeriod}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding RuleId}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </muxc:Expander>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding Export.ExportXlsxCommand}"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AccessKey="E"
                                AutomationProperties.AcceleratorKey="Alt+E">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXSPlus}">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                <TextBlock Text="Export XLSX"/>
                            </StackPanel>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="Export cashflow data to Excel" Style="{StaticResource InformativeToolTipStyle}"/>
                            </ToolTipService.ToolTip>
                        </Button>
                    </Grid>
                    
                    <!-- Enhanced Cashflow Table with Responsive Scrolling -->
                    <Border Grid.Row="1"
                            Style="{StaticResource CardContainerStyle}"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            MinHeight="200">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource ResponsiveScrollViewer}">
                            <controls:DataGrid x:Name="CashflowGrid" Style="{StaticResource ModernDataGridStyle}"
                                               ItemsSource="{Binding Results.Cashflows}"
                                               HeadersVisibility="Column"
                                               CanUserSortColumns="True"
                                               CanUserReorderColumns="True"
                                               CanUserResizeColumns="True"
                                               AutoGenerateColumns="False"
                                               IsReadOnly="False"
                                               GridLinesVisibility="All"
                                               VerticalAlignment="Stretch"
                                               HorizontalAlignment="Stretch"
                                               MinHeight="150">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="60"/>
                                    <controls:DataGridTextColumn Header="Payment Type" Binding="{Binding PaymentType}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Cap. Interest" Binding="{Binding CapInterest}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Principal" Binding="{Binding Principal}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Interest" Binding="{Binding Interest}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Total Payment" Binding="{Binding TotalPayment}" Width="120"/>

                                    <controls:DataGridTextColumn Header="Balance" Binding="{Binding Balance}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Cashflow" Binding="{Binding Cashflow}" Width="120"/>
                                    <controls:DataGridTextColumn Header="Principal Runoff" Binding="{Binding PrincipalRunoff}" Width="130"/>
                                    <controls:DataGridTextColumn Header="Interest Runoff" Binding="{Binding InterestRunoff}" Width="130"/>
                                    <controls:DataGridTextColumn Header="Subsidy Allocation" Binding="{Binding SubsidyAllocation}" Width="130"/>
                                    <controls:DataGridTextColumn Header="IDC Breakdown" Binding="{Binding IdcBreakdown}" Width="120"/>
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Summary Totals -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,8,0,0" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Total Principal Paid" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding Results.TotalPrincipalPaid}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Interest Paid" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding Results.TotalInterestPaid}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Payments" FontSize="12" Opacity="0.7"/>
                                <TextBlock Text="{Binding Results.TotalPayments}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>

            <!-- MARK: Campaign Designer Tab with Icon -->
            <TabViewItem IsClosable="False" Style="{StaticResource IconTabViewItemStyle}">
                <TabViewItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceS}">
                        <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                        <TextBlock Text="Campaign Designer" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabViewItem.Header>
                <Grid Background="Transparent" Padding="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="{StaticResource SpaceM}" Margin="{StaticResource MarginBottomM}">
                        <appcontrols:CampaignDesignerHeaderView/>
                        <appcontrols:CampaignDesignerSummaryView/>
                    </StackPanel>

                    <appcontrols:CampaignDesignerTilesView Grid.Row="1"
                                                           LayoutStrategy="ItemsRepeaterUniformGrid"
                                                           IsDetailed="{Binding Comparison.IsDesignerDetailed, Mode=TwoWay}"/>
                </Grid>
            </TabViewItem>
        </TabView.TabItems>
    </TabView>
</Grid>
</Window>
