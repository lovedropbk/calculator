<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- ========================================== -->
    <!-- Fluent Theme Tokens: Density, Spacing, Typography -->
    <!-- Centralized tokens to keep UI consistent -->
    <!-- ========================================== -->

    <!-- Density Tokens -->
    <x:Double x:Key="CompactControlHeight">28</x:Double>
    <x:Double x:Key="StandardControlHeight">32</x:Double>

    <Thickness x:Key="CompactTextPadding">6,4,6,4</Thickness>
    <Thickness x:Key="CompactComboPadding">6,4,24,4</Thickness>
    <Thickness x:Key="CompactNumberPadding">6,4,36,4</Thickness>
    <Thickness x:Key="StandardTextPadding">8,6,8,6</Thickness>

    <x:Double x:Key="ControlCornerRadius">6</x:Double>
    <x:Double x:Key="CardCornerRadiusToken">8</x:Double>

    <!-- Spacing Tokens -->
    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>

    <Thickness x:Key="CardPaddingCompact">12</Thickness>
    <Thickness x:Key="CardPaddingStandard">16</Thickness>

    <!-- Typography Tokens -->
    <x:Double x:Key="FontSizeDisplay">24</x:Double>
    <x:Double x:Key="FontSizeHeader">18</x:Double>
    <x:Double x:Key="FontSizeSectionHeaderToken">16</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>

    <!-- Base Text Styles -->
    <Style x:Key="TokenSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSectionHeaderToken}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,{StaticResource SpaceS},0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TokenLabelTextStyle" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.78"/>
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Dense Control Styles -->
    <Style x:Key="DenseTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="{StaticResource CompactControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource CompactTextPadding}"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    </Style>

    <!-- Dense variant with right suffix space (e.g., %, THB) -->
    <Style x:Key="DenseTextBoxWithSuffixStyle" TargetType="TextBox" BasedOn="{StaticResource DenseTextBoxStyle}">
        <Setter Property="Padding" Value="6,4,24,4"/>
    </Style>

    <Style x:Key="DenseComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource CompactControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource CompactComboPadding}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
    </Style>

    <Style x:Key="DenseNumberBoxStyle" TargetType="muxc:NumberBox">
        <Setter Property="Height" Value="{StaticResource CompactControlHeight}"/>
        <Setter Property="Padding" Value="{StaticResource CompactNumberPadding}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
    </Style>

    <Style x:Key="DenseButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="10,6,10,6"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Card Surface Style using tokens -->
    <Style x:Key="TokenCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadiusToken}"/>
        <Setter Property="Padding" Value="{StaticResource CardPaddingStandard}"/>
    </Style>

  <!-- Dense NumberBox variants with extra right padding for in-field labels -->
  <Style x:Key="DenseNumberBoxWithLabel52Style" TargetType="muxc:NumberBox" BasedOn="{StaticResource DenseNumberBoxStyle}">
    <Setter Property="Padding" Value="6,4,52,4"/>
  </Style>
  <Style x:Key="DenseNumberBoxWithLabel40Style" TargetType="muxc:NumberBox" BasedOn="{StaticResource DenseNumberBoxStyle}">
    <Setter Property="Padding" Value="6,4,40,4"/>
  </Style>

  <!-- Dense ToggleSwitch tokens -->
  <x:Double x:Key="DenseToggleTrackWidth">36</x:Double>
  <x:Double x:Key="DenseToggleTrackHeight">16</x:Double>
  <x:Double x:Key="DenseToggleThumbDiameter">12</x:Double>
  <x:Double x:Key="DenseToggleThumbMargin">2</x:Double>

  <!-- Dense ToggleSwitch with compact template and VisualStates -->
  <Style x:Key="DenseToggleSwitchStyle" TargetType="ToggleSwitch">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Height" Value="{StaticResource CompactControlHeight}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="OnContent" Value="On"/>
    <Setter Property="OffContent" Value="Off"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleSwitch">
          <Grid x:Name="Root" MinWidth="{TemplateBinding MinWidth}" VerticalAlignment="{TemplateBinding VerticalAlignment}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Switch -->
            <Grid Grid.Column="1"
                  x:Name="SwitchRoot"
                  Width="{StaticResource DenseToggleTrackWidth}"
                  Height="{StaticResource DenseToggleTrackHeight}"
                  Margin="8,0,8,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
              <Border x:Name="Track"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"/>
              <Border x:Name="Thumb"
                      Width="{StaticResource DenseToggleThumbDiameter}"
                      Height="{StaticResource DenseToggleThumbDiameter}"
                      Background="{ThemeResource ControlFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="999">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="ThumbT" X="{StaticResource DenseToggleThumbMargin}"/>
                </Border.RenderTransform>
              </Border>
            </Grid>

            <!-- On/Off text -->
            <ContentPresenter x:Name="OffPresenter"
                              Grid.Column="2"
                              Content="{TemplateBinding OffContent}"
                              Margin="0,0,0,0"
                              VerticalAlignment="Center"/>
            <ContentPresenter x:Name="OnPresenter"
                              Grid.Column="2"
                              Content="{TemplateBinding OnContent}"
                              Margin="0,0,0,0"
                              VerticalAlignment="Center"/>

            <VisualStateManager.VisualStateGroups>
              <!-- Toggle states (driven by IsOn) -->
              <VisualStateGroup x:Name="ToggleStates">
                <VisualState x:Name="Off">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OffPresenter" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OnPresenter" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="ThumbT" Storyboard.TargetProperty="X" To="{StaticResource DenseToggleThumbMargin}" Duration="0:0:0.1"/>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="On">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OffPresenter" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="OnPresenter" Storyboard.TargetProperty="Visibility">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                    </ObjectAnimationUsingKeyFrames>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Track" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </ObjectAnimationUsingKeyFrames>
                    <!-- On offset = TrackWidth - ThumbDiameter - (2*Margin) = 36 - 12 - 4 = 20 -->
                    <DoubleAnimation Storyboard.TargetName="ThumbT" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.1"/>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>

              <!-- Pointer/press/disabled states -->
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.1"/>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.1"/>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0"/>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>