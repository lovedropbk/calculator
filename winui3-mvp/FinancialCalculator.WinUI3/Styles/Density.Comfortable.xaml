<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Comfortable density overrides (applied after FluentTheme) -->

  <!-- Spacing scale (slightly larger) -->
  <x:Double x:Key="SpaceXS">6</x:Double>
  <x:Double x:Key="SpaceS">12</x:Double>
  <x:Double x:Key="SpaceM">16</x:Double>
  <x:Double x:Key="SpaceL">20</x:Double>

  <!-- Form/stack spacing -->
  <x:Double x:Key="FormRowSpacing">6</x:Double>
  <x:Double x:Key="FormColumnSpacing">6</x:Double>
  <x:Double x:Key="StackedCardSpacing">12</x:Double>
  <Thickness x:Key="LabelToValueMargin">12,0,0,0</Thickness>

  <!-- Control heights/paddings used by Dense* styles in comfortable mode -->
  <x:Double x:Key="CompactControlHeight">32</x:Double>
  <Thickness x:Key="CompactTextPadding">8,6,8,6</Thickness>
  <Thickness x:Key="CompactComboPadding">8,6,24,6</Thickness>
  <Thickness x:Key="CompactNumberPadding">8,6,36,6</Thickness>

  <!-- Card paddings -->
  <Thickness x:Key="CardPaddingStandard">20</Thickness>
  <Thickness x:Key="SectionPaddingM">16</Thickness>
  <Thickness x:Key="SectionPaddingS">12</Thickness>
  <Thickness x:Key="CardOuterMarginStandard">16,16,16,16</Thickness>
  <x:Double x:Key="LoaderIndicatorSize">56</x:Double>

  <!-- Stack min heights (left + center) -->
  <x:Double x:Key="DealInputsMinHeight">360</x:Double>
  <x:Double x:Key="GoalSeekMinHeight">260</x:Double>
  <x:Double x:Key="CenterTopMinHeight">240</x:Double>
  <x:Double x:Key="CenterTopMaxHeight">480</x:Double>
  <x:Double x:Key="CenterBottomMinHeight">240</x:Double>

</ResourceDictionary>
