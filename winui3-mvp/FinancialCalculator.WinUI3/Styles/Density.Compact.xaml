<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Compact density overrides (applied after FluentTheme) -->

  <!-- Spacing scale -->
  <x:Double x:Key="SpaceXS">4</x:Double>
  <x:Double x:Key="SpaceS">8</x:Double>
  <x:Double x:Key="SpaceM">12</x:Double>
  <x:Double x:Key="SpaceL">16</x:Double>

  <!-- Form/stack spacing -->
  <x:Double x:Key="FormRowSpacing">4</x:Double>
  <x:Double x:Key="FormColumnSpacing">4</x:Double>
  <x:Double x:Key="StackedCardSpacing">8</x:Double>
  <Thickness x:Key="LabelToValueMargin">8,0,0,0</Thickness>

  <!-- Control heights/paddings for Dense* styles -->
  <x:Double x:Key="CompactControlHeight">28</x:Double>
  <Thickness x:Key="CompactTextPadding">6,4,6,4</Thickness>
  <Thickness x:Key="CompactComboPadding">6,4,24,4</Thickness>
  <Thickness x:Key="CompactNumberPadding">6,4,36,4</Thickness>

  <!-- Card paddings -->
  <Thickness x:Key="CardPaddingStandard">16</Thickness>
  <Thickness x:Key="SectionPaddingM">12</Thickness>
  <Thickness x:Key="SectionPaddingS">8</Thickness>
  <Thickness x:Key="CardOuterMarginStandard">12,12,12,12</Thickness>
  <x:Double x:Key="LoaderIndicatorSize">40</x:Double>

  <!-- Stack min heights (left + center) -->
  <x:Double x:Key="DealInputsMinHeight">320</x:Double>
  <x:Double x:Key="GoalSeekMinHeight">220</x:Double>
  <x:Double x:Key="CenterTopMinHeight">200</x:Double>
  <x:Double x:Key="CenterTopMaxHeight">400</x:Double>
  <x:Double x:Key="CenterBottomMinHeight">200</x:Double>

</ResourceDictionary>
