<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- ========================================== -->
    <!-- Campaign Designer Tokens (Fluent v2-based) -->
    <!-- ========================================== -->

    <!-- Tile sizing -->
    <x:Double x:Key="DesignerTileWidth">360</x:Double>
    <x:Double x:Key="DesignerTileMinWidth">320</x:Double>
    <x:Double x:Key="DesignerTileMaxWidth">420</x:Double>

    <!-- Tile gaps and paddings -->
    <x:Double x:Key="DesignerTileGap">16</x:Double>
    <Thickness x:Key="DesignerHeaderMargin">0,0,0,12</Thickness>
    <Thickness x:Key="DesignerCardPadding">12</Thickness>

    <!-- Host padding (tiles area) -->
    <Thickness x:Key="DesignerTilesPadding">0,0,0,0</Thickness>

    <!-- ========================================== -->
    <!-- Typography built atop Fluent token styles  -->
    <!-- ========================================== -->

    <!-- Consistent caption opacity for all captions -->
    <!-- Based on TokenLabelTextStyle from Styles/FluentTheme.xaml -->
    <Style x:Key="TokenCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TokenLabelTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Opacity" Value="0.7"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- Optional section header variant for Designer -->
    <!-- Based on TokenSectionHeaderTextStyle from Styles/FluentTheme.xaml -->
    <Style x:Key="DesignerSectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TokenSectionHeaderTextStyle}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Tile container style (inherits card visuals) -->
    <Style x:Key="DesignerTileContainerStyle" TargetType="Border" BasedOn="{StaticResource CardContainerStyle}">
        <Setter Property="Padding" Value="{StaticResource DesignerCardPadding}"/>
        <Setter Property="Width" Value="{StaticResource DesignerTileWidth}"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- Tile header text style -->
    <Style x:Key="DesignerTileTitleTextStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Compact toggle usage marker (bind via x:Key from FluentTheme.xaml DenseToggleSwitchStyle) -->
    <!-- Usage: Style="{StaticResource DenseToggleSwitchStyle}" -->

</ResourceDictionary>